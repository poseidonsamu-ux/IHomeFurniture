@using System.Linq
@model List<IHomeFurniture.Controllers.StaffRow>

@{
    ViewBag.Title = "Theo dõi sản phẩm";
    Layout = "~/Views/Shared/_LayoutStaff.cshtml";

    string q = (string)ViewBag.Search;
    bool low = (bool)ViewBag.SapHet;

    int total = Model.Count;
    int warning = Model.Count(x => x.N("SoLuongTon") <= 5);
    int available = Model.Count(x => x.N("SoLuongTon") > 5);
}

<div class="mb-7">
    <h1 class="text-2xl font-bold text-gray-800">
        Quản lý kho sản phẩm
    </h1>

    <p class="text-sm text-gray-500 mt-2">
        Theo dõi số lượng tồn, giá bán và cập nhật kho hàng IHOME.
    </p>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-7">

    <div class="staff-card p-5 flex items-center gap-4">

        <div class="w-14 h-14 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center">
            <i class="fa-solid fa-couch text-xl"></i>
        </div>

        <div>
            <p class="text-sm text-gray-500">
                Sản phẩm hiển thị
            </p>

            <h3 class="text-2xl font-bold text-gray-800 mt-1">
                @total
            </h3>
        </div>

    </div>

    <div class="staff-card p-5 flex items-center gap-4">

        <div class="w-14 h-14 rounded-xl bg-green-100 text-green-600 flex items-center justify-center">
            <i class="fa-solid fa-boxes-stacked text-xl"></i>
        </div>

        <div>
            <p class="text-sm text-gray-500">
                Tồn trên 5 sản phẩm
            </p>

            <h3 class="text-2xl font-bold text-gray-800 mt-1">
                @available
            </h3>
        </div>

    </div>

    <div class="staff-card p-5 flex items-center gap-4">

        <div class="w-14 h-14 rounded-xl bg-red-100 text-red-600 flex items-center justify-center">
            <i class="fa-solid fa-triangle-exclamation text-xl"></i>
        </div>

        <div>
            <p class="text-sm text-gray-500">
                Sắp hết / hết hàng
            </p>

            <h3 class="text-2xl font-bold text-gray-800 mt-1">
                @warning
            </h3>
        </div>

    </div>

</div>

<section class="staff-card overflow-hidden">

    <div class="p-5 border-b border-gray-100">

        <form method="get"
              action="@Url.Action("TheoDoiSanPham")"
              class="flex flex-col md:flex-row gap-3">

            <div class="relative flex-1">

                <i class="fa-solid fa-search absolute left-4 top-3.5 text-gray-400"></i>

                <input name="q"
                       value="@q"
                       class="staff-input w-full pl-11"
                       placeholder="Tìm tên sản phẩm hoặc mã sản phẩm..." />
            </div>

            <select name="sapHet"
                    class="staff-input md:w-56">

                <option value="false"
                        @(!low ? "selected" : "")>
                    Tất cả sản phẩm
                </option>

                <option value="true"
                        @(low ? "selected" : "")>
                    Sản phẩm tồn ≤ 5
                </option>

            </select>

            <button type="submit" class="staff-button">
                <i class="fa-solid fa-filter"></i>
                Lọc
            </button>

            <a href="@Url.Action("TheoDoiSanPham")"
               class="px-4 py-2.5 border border-gray-300 rounded-xl text-sm font-semibold text-gray-600 hover:bg-gray-50 text-center">
                Đặt lại
            </a>

        </form>

    </div>

    <div class="overflow-x-auto">

        <table class="staff-table">

            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Danh mục</th>
                    <th>Giá bán</th>
                    <th>Số lượng</th>
                    <th>Trạng thái kho</th>
                    <th>Điều chỉnh tồn kho</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    int stock = item.N("SoLuongTon");

                    <tr>
                        <td>
                            <div class="flex items-center gap-3 min-w-[200px]">

                                <div class="w-12 h-12 bg-gradient-to-br from-blue-50 to-gray-100 rounded-xl flex items-center justify-center text-blue-500 shrink-0">
                                    <i class="fa-solid fa-couch text-lg"></i>
                                </div>

                                <div>
                                    <p class="font-semibold text-gray-800">
                                        @item.T("TenSP")
                                    </p>

                                    <p class="text-xs text-gray-400 mt-1">
                                        #SP@item.N("MaSP").ToString("D4")
                                    </p>
                                </div>

                            </div>
                        </td>

                        <td class="text-gray-600">
                            @item.T("TenDanhMuc")
                        </td>

                        <td>
                            <p class="font-semibold text-gray-800 whitespace-nowrap">
                                @item.Vnd("GiaBan")
                            </p>
                        </td>

                        <td>
                            <span class="text-lg font-bold @(stock <= 5 ? "text-red-600" : "text-gray-800")">
                                @stock
                            </span>
                        </td>

                        <td>
                            @if (!item.Yes("TrangThai"))
                            {
                                <span class="bg-gray-100 text-gray-600 px-3 py-1.5 rounded-full text-xs font-semibold">
                                    Ngừng bán
                                </span>
                            }
                            else if (stock == 0)
                            {
                                <span class="bg-red-100 text-red-700 px-3 py-1.5 rounded-full text-xs font-semibold">
                                    <i class="fa-solid fa-circle-xmark mr-1"></i>
                                    Hết hàng
                                </span>
                            }
                            else if (stock <= 5)
                            {
                                <span class="bg-yellow-100 text-yellow-700 px-3 py-1.5 rounded-full text-xs font-semibold">
                                    <i class="fa-solid fa-triangle-exclamation mr-1"></i>
                                    Sắp hết
                                </span>
                            }
                            else
                            {
                                <span class="bg-green-100 text-green-700 px-3 py-1.5 rounded-full text-xs font-semibold">
                                    <i class="fa-solid fa-check-circle mr-1"></i>
                                    Còn hàng
                                </span>
                            }
                        </td>

                        <td>
                            @using (Html.BeginForm(
                                "CapNhatTonKho",
                                "Staff",
                                FormMethod.Post,
                                new { @class = "flex flex-col gap-2 min-w-[185px]" }
                            ))
                            {
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@item.N("MaSP")" />

                                <input type="number"
                                       name="soLuong"
                                       value="@stock"
                                       min="0"
                                       max="1000000"
                                       required
                                       class="staff-input w-full text-sm" />

                                <input type="text"
                                       name="lyDo"
                                       minlength="5"
                                       maxlength="200"
                                       required
                                       class="staff-input w-full text-xs"
                                       placeholder="Lý do điều chỉnh..." />

                                <button type="submit"
                                        onclick="return confirm('Bạn chắc chắn muốn thay đổi tồn kho?')"
                                        class="bg-blue-600 hover:bg-blue-700 text-white py-2 rounded-lg text-xs font-semibold transition">
                                    <i class="fa-solid fa-floppy-disk mr-1"></i>
                                    Lưu tồn kho
                                </button>
                            }
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6"
                            class="py-16 text-center text-gray-400">

                            <i class="fa-solid fa-box-open text-4xl mb-4"></i>
                            <p>Không có sản phẩm phù hợp.</p>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</section>

<div class="mt-5 bg-blue-50 border border-blue-100 rounded-xl p-4 flex gap-3">

    <i class="fa-solid fa-circle-info text-blue-600 mt-0.5"></i>

    <p class="text-sm text-blue-800">
        <strong>Lưu ý:</strong> Mọi thao tác chỉnh sửa tồn kho
        đều được ghi vào bảng NHATKYNHANVIEN.
        Hãy nhập lý do chính xác trước khi lưu.
        Bảng hiển thị tối đa 200 sản phẩm khớp bộ lọc.
    </p>

</div>