@using System.Linq
@model List<IHomeFurniture.Controllers.StaffRow>

@{
    ViewBag.Title = "Quản lý khách hàng";
    Layout = "~/Views/Shared/_LayoutStaff.cshtml";

    string q = (string)ViewBag.Search;
}

<div class="flex flex-wrap justify-between items-center gap-4 mb-7">

    <div>
        <h1 class="text-2xl font-bold text-gray-800">
            Danh sách khách hàng
        </h1>

        <p class="text-sm text-gray-500 mt-2">
            Tra cứu thông tin và theo dõi hoạt động mua hàng.
        </p>
    </div>

    <span class="bg-blue-50 text-blue-700 px-4 py-2 rounded-xl font-semibold text-sm">
        <i class="fa-solid fa-users mr-2"></i>
        @Model.Count kết quả
    </span>

</div>

<section class="staff-card overflow-hidden">

    <div class="p-5 border-b border-gray-100">

        <form method="get"
              action="@Url.Action("QuanLyKhachHang")"
              class="flex flex-col md:flex-row gap-3">

            <div class="relative flex-1">

                <i class="fa-solid fa-search absolute left-4 top-3.5 text-gray-400"></i>

                <input name="q"
                       value="@q"
                       class="staff-input w-full pl-11"
                       placeholder="Tìm tên, email, số điện thoại..." />

            </div>

            <button type="submit" class="staff-button">
                <i class="fa-solid fa-magnifying-glass"></i>
                Tìm kiếm
            </button>

            <a href="@Url.Action("QuanLyKhachHang")"
               class="px-4 py-2.5 border border-gray-300 rounded-xl text-sm font-semibold text-gray-600 hover:bg-gray-50 text-center">
                Đặt lại
            </a>

        </form>

    </div>

    <div class="overflow-x-auto">

        <table class="staff-table">

            <thead>
                <tr>
                    <th>Khách hàng</th>
                    <th>Thông tin liên hệ</th>
                    <th>Ngày tham gia</th>
                    <th>Số đơn</th>
                    <th>Đã mua</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="flex items-center gap-3 min-w-[180px]">

                                <div class="w-11 h-11 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-bold shrink-0">
                                    <i class="fa-solid fa-user"></i>
                                </div>

                                <div>
                                    <p class="font-semibold text-gray-800">
                                        @item.T("HoTen")
                                    </p>

                                    <p class="text-xs text-gray-400 mt-1">
                                        @item.T("TaiKhoan")
                                    </p>
                                </div>
                            </div>
                        </td>

                        <td>
                            <p class="text-gray-700 break-all">
                                <i class="fa-regular fa-envelope text-gray-400 mr-1"></i>
                                @item.T("Email")
                            </p>

                            <p class="text-xs text-gray-500 mt-2">
                                <i class="fa-solid fa-phone text-gray-400 mr-1"></i>
                                @item.T("DienThoai")
                            </p>

                            <p class="text-xs text-gray-400 mt-2 max-w-[250px]">
                                @item.T("DiaChi")
                            </p>
                        </td>

                        <td class="text-gray-600 whitespace-nowrap">
                            @item.Date("NgayTao")
                        </td>

                        <td>
                            <span class="font-bold text-gray-800">
                                @item.N("SoDon")
                            </span>
                        </td>

                        <td class="font-semibold text-blue-600 whitespace-nowrap">
                            @item.Vnd("DaMua")
                        </td>

                        <td>
                            @if (item.Yes("TrangThai"))
                            {
                                <span class="bg-green-100 text-green-700 px-3 py-1.5 rounded-full text-xs font-semibold">
                                    Hoạt động
                                </span>
                            }
                            else
                            {
                                <span class="bg-gray-100 text-gray-600 px-3 py-1.5 rounded-full text-xs font-semibold">
                                    Đã khóa
                                </span>
                            }
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6"
                            class="py-16 text-center text-gray-400">

                            <i class="fa-solid fa-users-slash text-4xl mb-4"></i>
                            <p>Không tìm thấy khách hàng.</p>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</section>

<div class="mt-5 bg-white rounded-xl border border-gray-200 px-5 py-4">

    <p class="text-sm text-gray-500">
        <i class="fa-solid fa-shield-halved text-blue-500 mr-2"></i>
        Nhân viên được phép tra cứu khách hàng để hỗ trợ
        đơn hàng và chăm sóc khách hàng. Việc khóa, xóa hoặc
        thay đổi tài khoản thuộc quyền quản trị viên.
    </p>

</div>