@{
    Layout = "~/Views/Shared/_LayoutStaff.cshtml";
    ViewBag.Title = "Bảng điều khiển nhân viên";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Bảng tổng quan nhân viên</h3>
        <p class="text-muted mb-0">Theo dõi tiến độ đơn hàng và hoạt động bán lẻ nội thất.</p>
    </div>
</div>

<!-- 4 Thẻ thống kê nhanh -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card card-stat bg-white p-3 border-start border-warning border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small">Đơn chờ duyệt</span>
                    <h3 class="fw-bold mb-0 text-warning">0</h3>
                </div>
                <i class="fa-solid fa-clock-rotate-left fa-2x text-warning opacity-75"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card card-stat bg-white p-3 border-start border-primary border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small">Đơn đang giao</span>
                    <h3 class="fw-bold mb-0 text-primary">0</h3>
                </div>
                <i class="fa-solid fa-truck-fast fa-2x text-primary opacity-75"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card card-stat bg-white p-3 border-start border-danger border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small">Sản phẩm sắp hết</span>
                    <h3 class="fw-bold mb-0 text-danger">0</h3>
                </div>
                <i class="fa-solid fa-boxes-packing fa-2x text-danger opacity-75"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card card-stat bg-white p-3 border-start border-success border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small">Khách hàng</span>
                    <h3 class="fw-bold mb-0 text-success">0</h3>
                </div>
                <i class="fa-solid fa-users fa-2x text-success opacity-75"></i>
            </div>
        </div>
    </div>
</div>

<!-- Bảng đơn đặt hàng -->
<div class="card card-stat bg-white">
    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0">Đơn đặt hàng gần đây</h5>
        <a href="@Url.Action("QuanLyDonHang", "Staff")" class="btn btn-sm btn-outline-primary">Tất cả đơn hàng</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã Đơn</th>
                    <th>Khách hàng</th>
                    <th>Thời gian đặt</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                <!-- Vị trí sau này ní dùng vòng lặp foreach duyệt dữ liệu từ SQL lên -->
                <tr>
                    <td colspan="6" class="text-center py-4 text-muted">
                        Chưa có dữ liệu đơn hàng.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>