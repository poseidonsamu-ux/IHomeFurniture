@{
    Layout = null;
    ViewBag.Title = "Đăng nhập Staff";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Đăng nhập nhân viên - IHOME</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
          rel="stylesheet" />

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>

<body class="min-h-screen bg-gray-100 flex">

    <section class="hidden lg:flex lg:w-1/2 bg-gray-900 text-white p-12 flex-col justify-between relative overflow-hidden">

        <div class="absolute -top-32 -right-32 w-96 h-96 rounded-full bg-blue-600/20 blur-3xl"></div>

        <div class="absolute -bottom-32 -left-24 w-96 h-96 rounded-full bg-blue-500/10 blur-3xl"></div>

        <div class="relative z-10">

            <h1 class="text-3xl font-bold tracking-widest">
                iHOME<span class="text-blue-500">.</span>
            </h1>

            <span class="text-xs tracking-[.3em] text-gray-400 mt-2 block">
                FURNITURE MANAGEMENT
            </span>

        </div>

        <div class="relative z-10 max-w-lg">

            <div class="w-20 h-20 bg-blue-600/20 rounded-2xl flex items-center justify-center mb-8 border border-blue-500/20">
                <i class="fa-solid fa-couch text-blue-400 text-4xl"></i>
            </div>

            <h2 class="text-5xl font-extrabold leading-tight">
                Quản lý
                <span class="text-blue-400">thông minh.</span>
                Vận hành hiệu quả.
            </h2>

            <p class="text-gray-400 text-lg leading-8 mt-7">
                Hệ thống quản lý nhân viên IHOME Furniture,
                hỗ trợ xử lý đơn hàng, quản lý kho và chăm sóc khách hàng.
            </p>

            <div class="grid grid-cols-3 gap-4 mt-10">

                <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center">
                    <i class="fa-solid fa-box text-blue-400 text-2xl"></i>
                    <p class="text-xs mt-3 text-gray-300">Đơn hàng</p>
                </div>

                <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center">
                    <i class="fa-solid fa-couch text-blue-400 text-2xl"></i>
                    <p class="text-xs mt-3 text-gray-300">Sản phẩm</p>
                </div>

                <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center">
                    <i class="fa-solid fa-headset text-blue-400 text-2xl"></i>
                    <p class="text-xs mt-3 text-gray-300">Khách hàng</p>
                </div>

            </div>

        </div>

        <div class="relative z-10 text-xs text-gray-500">
            © @DateTime.Now.Year IHOME Furniture. Staff Workspace.
        </div>

    </section>

    <section class="w-full lg:w-1/2 flex items-center justify-center p-5 md:p-12">

        <div class="w-full max-w-md">

            <div class="lg:hidden mb-10 text-center">

                <h1 class="text-3xl font-bold text-gray-900 tracking-widest">
                    iHOME<span class="text-blue-500">.</span>
                </h1>

                <p class="text-xs tracking-wider text-gray-500 mt-2">
                    STAFF PORTAL
                </p>

            </div>

            <div class="bg-white rounded-2xl p-7 md:p-10 shadow-xl shadow-gray-200/50 border border-gray-100">

                <div class="w-14 h-14 bg-blue-100 text-blue-600 rounded-xl flex items-center justify-center mb-6">
                    <i class="fa-solid fa-user-shield text-2xl"></i>
                </div>

                <h2 class="text-2xl font-bold text-gray-800">
                    Đăng nhập nhân viên
                </h2>

                <p class="text-gray-500 text-sm mt-3 mb-8 leading-6">
                    Chào mừng bạn quay lại hệ thống IHOME.
                    Vui lòng đăng nhập để bắt đầu làm việc.
                </p>

                @if (ViewBag.Error != null)
                {
                    <div class="bg-red-50 text-red-600 border border-red-200 rounded-xl p-4 text-sm mb-6">
                        <i class="fa-solid fa-circle-exclamation mr-2"></i>
                        @ViewBag.Error
                    </div>
                }

                @using (Html.BeginForm(
                    "DangNhap",
                    "Staff",
                    FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="mb-5">

                        <label class="block text-sm font-semibold text-gray-700 mb-2"
                               for="username">
                            Tên đăng nhập
                        </label>

                        <div class="relative">

                            <i class="fa-solid fa-user absolute left-4 top-4 text-gray-400"></i>

                            <input id="username"
                                   type="text"
                                   name="username"
                                   maxlength="50"
                                   required
                                   autocomplete="username"
                                   placeholder="Nhập tên đăng nhập"
                                   class="w-full border border-gray-300 rounded-xl py-3.5 pl-12 pr-4 outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-100 transition" />

                        </div>

                    </div>

                    <div class="mb-7">

                        <label class="block text-sm font-semibold text-gray-700 mb-2"
                               for="password">
                            Mật khẩu
                        </label>

                        <div class="relative">

                            <i class="fa-solid fa-lock absolute left-4 top-4 text-gray-400"></i>

                            <input id="password"
                                   type="password"
                                   name="password"
                                   required
                                   autocomplete="current-password"
                                   placeholder="Nhập mật khẩu"
                                   class="w-full border border-gray-300 rounded-xl py-3.5 pl-12 pr-12 outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-100 transition" />

                            <button type="button"
                                    onclick="togglePassword()"
                                    class="absolute right-4 top-3.5 text-gray-400 hover:text-blue-600"
                                    aria-label="Hiện hoặc ẩn mật khẩu">
                                <i id="passwordIcon"
                                   class="fa-solid fa-eye"></i>
                            </button>

                        </div>

                    </div>

                    <button type="submit"
                            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl py-4 transition shadow-lg shadow-blue-100">
                        Đăng nhập hệ thống
                        <i class="fa-solid fa-arrow-right ml-2"></i>
                    </button>
                }

                <div class="border-t border-gray-100 mt-8 pt-6">

                    <p class="text-xs text-gray-400 text-center leading-5">
                        <i class="fa-solid fa-shield-halved text-blue-500 mr-1"></i>
                        Khu vực dành riêng cho nhân viên được cấp quyền.
                        Liên hệ quản trị viên nếu cần hỗ trợ tài khoản.
                    </p>

                </div>

            </div>

            <p class="text-center text-sm text-gray-400 mt-8">
                IHOME Furniture Management System
            </p>

        </div>

    </section>

    <script>
        function togglePassword() {
            var input = document.getElementById("password");
            var icon = document.getElementById("passwordIcon");

            if (input.type === "password") {
                input.type = "text";
                icon.className = "fa-solid fa-eye-slash";
            } else {
                input.type = "password";
                icon.className = "fa-solid fa-eye";
            }
        }
    </script>

</body>
</html>