
@using System.Linq
@model List<IHomeFurniture.Controllers.StaffRow>

@{
    ViewBag.Title = "Tư vấn khách hàng";
    Layout = "~/Views/Shared/_LayoutStaff.cshtml";

    int status = (int)ViewBag.TrangThai;

    int all = Model.Count;
    int waiting = Model.Count(x => !x.Yes("TrangThai"));
    int done = Model.Count(x => x.Yes("TrangThai"));
}

<div class="mb-7">

    <h1 class="text-2xl font-bold text-gray-800">
        Chăm sóc & tư vấn khách hàng
    </h1>

    <p class="text-sm text-gray-500 mt-2">
        Tiếp nhận, giải đáp và quản lý các yêu cầu liên hệ
        từ khách hàng IHOME.
    </p>

</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-7">

    <a href="@Url.Action("TuVanKhachHang", new { trangThai = 0 })"
       class="staff-card p-5 hover:shadow-md transition">

        <div class="flex items-center justify-between">

            <div>
                <p class="text-gray-500 text-sm">
                    Yêu cầu đang hiển thị
                </p>

                <h3 class="text-3xl font-bold text-gray-800 mt-2">
                    @all
                </h3>
            </div>

            <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center">
                <i class="fa-solid fa-inbox text-xl"></i>
            </div>

        </div>

    </a>

    <a href="@Url.Action("TuVanKhachHang", new { trangThai = 1 })"
       class="staff-card p-5 hover:shadow-md transition">

        <div class="flex items-center justify-between">

            <div>
                <p class="text-gray-500 text-sm">
                    Chưa xử lý trong bộ lọc
                </p>

                <h3 class="text-3xl font-bold text-yellow-600 mt-2">
                    @waiting
                </h3>
            </div>

            <div class="w-12 h-12 rounded-xl bg-yellow-100 text-yellow-600 flex items-center justify-center">
                <i class="fa-solid fa-hourglass-half text-xl"></i>
            </div>

        </div>

    </a>

    <a href="@Url.Action("TuVanKhachHang", new { trangThai = 2 })"
       class="staff-card p-5 hover:shadow-md transition">

        <div class="flex items-center justify-between">

            <div>
                <p class="text-gray-500 text-sm">
                    Đã xử lý trong bộ lọc
                </p>

                <h3 class="text-3xl font-bold text-green-600 mt-2">
                    @done
                </h3>
            </div>

            <div class="w-12 h-12 rounded-xl bg-green-100 text-green-600 flex items-center justify-center">
                <i class="fa-solid fa-circle-check text-xl"></i>
            </div>

        </div>

    </a>

</div>

<section class="staff-card overflow-hidden">

    <div class="p-5 border-b border-gray-100 flex flex-wrap justify-between items-center gap-3">

        <h2 class="font-bold text-gray-800 text-lg">
            <i class="fa-solid fa-comments text-blue-500 mr-2"></i>
            Danh sách yêu cầu tư vấn
        </h2>

        <form method="get"
              action="@Url.Action("TuVanKhachHang")">

            <select name="trangThai"
                    onchange="this.form.submit()"
                    class="staff-input text-sm">

                <option value="0"
                        @(status == 0 ? "selected" : "")>
                    Tất cả
                </option>

                <option value="1"
                        @(status == 1 ? "selected" : "")>
                    Chưa xử lý
                </option>

                <option value="2"
                        @(status == 2 ? "selected" : "")>
                    Đã xử lý
                </option>

            </select>
        </form>

    </div>

    <div class="divide-y divide-gray-100">

        @foreach (var item in Model)
        {
            bool processed = item.Yes("TrangThai");

            <article class="p-5 lg:p-6 hover:bg-gray-50/60 transition">

                <div class="flex flex-col lg:flex-row lg:justify-between gap-4">

                    <div class="flex gap-4">

                        <div class="w-12 h-12 shrink-0 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center">
                            <i class="fa-solid fa-user"></i>
                        </div>

                        <div>
                            <div class="flex flex-wrap gap-2 items-center">

                                <h3 class="font-bold text-gray-800">
                                    @item.T("HoTen")
                                </h3>

                                @if (processed)
                                {
                                    <span class="bg-green-100 text-green-700 px-2.5 py-1 rounded-full text-xs font-semibold">
                                        Đã xử lý
                                    </span>
                                }
                                else
                                {
                                    <span class="bg-yellow-100 text-yellow-700 px-2.5 py-1 rounded-full text-xs font-semibold">
                                        Chờ tư vấn
                                    </span>
                                }

                            </div>

                            <p class="text-xs text-gray-500 mt-2">
                                <i class="fa-regular fa-envelope mr-1"></i>
                                @item.T("Email")
                            </p>

                            <p class="text-xs text-gray-500 mt-1">
                                <i class="fa-solid fa-phone mr-1"></i>
                                @item.T("DienThoai")
                            </p>
                        </div>

                    </div>

                    <div class="text-sm text-gray-400 lg:text-right">

                        <p>@("#LH" + item.N("MaLH").ToString("D4"))</p>

                        <p class="mt-1">
                            <i class="fa-regular fa-clock mr-1"></i>
                            @item.Date("NgayGui")
                        </p>

                    </div>

                </div>

                <div class="mt-5 lg:ml-16">

                    <h4 class="font-semibold text-gray-800 mb-2">
                        @item.T("TieuDe")
                    </h4>

                    <p class="text-sm text-gray-600 leading-7 whitespace-pre-wrap">
                        @item.T("NoiDung")
                    </p>

                    @if (!string.IsNullOrWhiteSpace(item.T("GhiChuXuLy")))
                    {
                        <div class="bg-blue-50 border-l-4 border-blue-400 rounded-r-xl p-4 mt-4">

                            <p class="text-xs font-bold text-blue-700 mb-2">
                                <i class="fa-solid fa-clipboard-check mr-1"></i>
                                GHI CHÚ XỬ LÝ
                            </p>

                            <p class="text-sm text-gray-700 whitespace-pre-wrap">
                                @item.T("GhiChuXuLy")
                            </p>

                            <p class="text-xs text-gray-400 mt-3">
                                @item.T("TenNhanVien") ·
                                @item.Date("NgayXuLy")
                            </p>

                        </div>
                    }

                    <details class="mt-5 border border-gray-200 rounded-xl bg-white">

                        <summary class="cursor-pointer p-4 font-semibold text-blue-600 text-sm select-none">
                            <i class="fa-solid fa-pen-to-square mr-2"></i>
                            @(processed ? "Cập nhật kết quả / Mở lại" : "Xử lý yêu cầu tư vấn")
                        </summary>

                        <div class="p-4 border-t border-gray-100">

                            @using (Html.BeginForm(
                                "XuLyLienHe",
                                "Staff",
                                FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@item.N("MaLH")" />

                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    Nội dung ghi chú
                                </label>

                                <textarea name="ghiChu"
                                          rows="4"
                                          minlength="5"
                                          maxlength="1000"
                                          required
                                          class="staff-input w-full"
                                          placeholder="Ví dụ: Đã liên hệ khách hàng, tư vấn sản phẩm phù hợp...">@item.T("GhiChuXuLy")</textarea>

                                <div class="flex flex-wrap gap-3 mt-4">

                                    <button type="submit"
                                            name="daXuLy"
                                            value="true"
                                            class="staff-button">
                                        <i class="fa-solid fa-check"></i>
                                        Lưu & hoàn tất
                                    </button>

                                    <button type="submit"
                                            name="daXuLy"
                                            value="false"
                                            class="px-4 py-2.5 rounded-xl border border-yellow-300 bg-yellow-50 text-yellow-700 hover:bg-yellow-100 text-sm font-semibold">
                                        <i class="fa-solid fa-rotate-left mr-1"></i>
                                        Lưu & chờ xử lý
                                    </button>

                                </div>
                            }

                        </div>

                    </details>

                </div>

            </article>
        }

        @if (!Model.Any())
        {
            <div class="py-20 text-center">

                <i class="fa-solid fa-comments text-5xl text-gray-300 mb-5"></i>

                <p class="text-gray-500 font-semibold">
                    Không có yêu cầu tư vấn phù hợp.
                </p>

                <p class="text-gray-400 text-sm mt-2">
                    Các liên hệ mới của khách hàng sẽ hiển thị tại đây.
                </p>

            </div>
        }
+
    </div>

</section>

<div class="mt-5 bg-blue-50 border border-blue-100 p-4 rounded-xl text-sm text-blue-800">
    <i class="fa-solid fa-circle-info mr-2"></i>
    Ghi chú và trạng thái xử lý được lưu vào SQL Server.
    Chức năng này chưa tự động gửi email hoặc tin nhắn cho khách hàng.
    Danh sách hiển thị tối đa 200 liên hệ theo bộ lọc.
</div>
