@using System.Linq
@model List<IHomeFurniture.Controllers.StaffRow>

@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Views/Shared/_LayoutStaff.cshtml";

    int selected = (int)ViewBag.TrangThai;
    int page = (int)ViewBag.Page;
    int total = (int)ViewBag.Total;
    string q = (string)ViewBag.Search;

    string[] statuses = {
        "Tất cả trạng thái",
        "Chờ xác nhận",
        "Đang chuẩn bị hàng",
        "Đang giao hàng",
        "Đã giao thành công",
        "Đã hủy",
        "Hoàn trả"
    };
}

<div class="flex flex-wrap justify-between items-center gap-4 mb-7">

    <div>
        <h1 class="text-2xl font-bold text-gray-800">
            Quản lý đơn hàng
        </h1>

        <p class="text-sm text-gray-500 mt-2">
            Quản lý thông tin, tiến độ và trạng thái đơn hàng.
        </p>
    </div>

    <div class="bg-blue-50 text-blue-700 px-4 py-2 rounded-xl font-semibold text-sm">
        <i class="fa-solid fa-box mr-2"></i>
        @total đơn hàng
    </div>

</div>

<section class="staff-card overflow-hidden">

    <div class="p-5 border-b border-gray-100">

        <form method="get"
              action="@Url.Action("QuanLyDonHang", "Staff")"
              class="flex flex-col md:flex-row gap-3">

            <div class="relative flex-1">

                <i class="fa-solid fa-magnifying-glass absolute left-4 top-3.5 text-gray-400"></i>

                <input type="text"
                       name="q"
                       value="@q"
                       class="staff-input w-full pl-11"
                       placeholder="Tìm mã đơn, tên hoặc SĐT khách hàng..." />
            </div>

            <select name="trangThai"
                    class="staff-input md:w-56">

                @for (int i = 0; i < statuses.Length; i++)
                {
                    <option value="@i"
                            @(selected == i ? "selected" : "")>
                        @statuses[i]
                    </option>
                }

            </select>

            <button type="submit" class="staff-button">
                <i class="fa-solid fa-filter"></i>
                Lọc
            </button>

            <a href="@Url.Action("QuanLyDonHang")"
               class="px-4 py-2.5 border border-gray-300 rounded-xl text-sm font-semibold text-gray-600 hover:bg-gray-50 text-center">
                Đặt lại
            </a>

        </form>
    </div>

    <div class="overflow-x-auto">

        <table class="staff-table">

            <thead>
                <tr>
                    <th>Mã đơn hàng</th>
                    <th>Khách hàng</th>
                    <th>Ngày đặt</th>
                    <th>Thanh toán</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <a class="text-blue-600 font-bold hover:underline"
                               href="@Url.Action("ChiTietDonHang", new { id = item.N("MaDonHang") })">
                                #@item.N("MaDonHang").ToString("D5")
                            </a>
                        </td>

                        <td>
                            <p class="font-semibold text-gray-800">
                                @item.T("HoTen")
                            </p>

                            <p class="text-xs text-gray-400 mt-1">
                                @item.T("DienThoaiNhan")
                            </p>
                        </td>

                        <td class="text-gray-600">
                            @item.Date("NgayDat")
                        </td>

                        <td class="text-gray-600">
                            @item.T("TenPhuongThuc")
                        </td>

                        <td class="font-bold text-gray-800 whitespace-nowrap">
                            @item.Vnd("TongTien")
                        </td>

                        <td>
                            <span class="staff-badge staff-badge-@(item.N("MaTT"))">
                                @item.T("TenTrangThai")
                            </span>
                        </td>

                        <td>
                            <a href="@Url.Action("ChiTietDonHang", new { id = item.N("MaDonHang") })"
                               class="inline-flex items-center gap-2 bg-blue-50 text-blue-600 hover:bg-blue-100 px-3 py-2 rounded-lg font-semibold text-xs transition">
                                <i class="fa-solid fa-eye"></i>
                                Chi tiết
                            </a>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7"
                            class="text-center py-16 text-gray-400">

                            <i class="fa-solid fa-box-open text-4xl mb-4"></i>

                            <p>Không tìm thấy đơn hàng phù hợp.</p>
                        </td>
                    </tr>
                }

            </tbody>

        </table>
    </div>

    <div class="px-5 py-4 border-t border-gray-100 flex justify-between items-center gap-3">

        <span class="text-sm text-gray-500">
            Trang @page / @Math.Max(1, (int)Math.Ceiling(total / 15.0))
        </span>

        <div class="flex gap-2">

            @if (page > 1)
            {
                <a href="@Url.Action("QuanLyDonHang", new { q, trangThai = selected, page = page - 1 })"
                   class="px-4 py-2 rounded-lg border border-gray-200 hover:bg-gray-50 text-sm">
                    <i class="fa-solid fa-angle-left mr-1"></i>
                    Trước
                </a>
            }

            @if (page * 15 < total)
            {
                <a href="@Url.Action("QuanLyDonHang", new { q, trangThai = selected, page = page + 1 })"
                   class="px-4 py-2 rounded-lg bg-blue-600 text-white hover:bg-blue-700 text-sm">
                    Tiếp
                    <i class="fa-solid fa-angle-right ml-1"></i>
                </a>
            }

        </div>

    </div>

</section>