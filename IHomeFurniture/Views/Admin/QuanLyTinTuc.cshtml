@model IEnumerable<IHomeFurniture.Models.TINTUC>
@{
    ViewBag.Title = "Quản lý Tin Tức";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="flex justify-between items-center mb-8">
    <h2 class="text-2xl font-black uppercase tracking-tight">Danh sách Tin Tức</h2>
    <a href="@Url.Action("ThemTinTuc", "Admin")" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-xl font-bold transition flex items-center gap-2 shadow-lg shadow-blue-200">
        <i class="fa-solid fa-plus"></i> Viết bài mới
    </a>
</div>

<div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm">
    <table class="w-full text-left border-collapse">
        <thead>
            <tr class="bg-gray-50 border-b border-gray-200 text-xs uppercase text-gray-500 font-bold">
                <th class="p-4 w-20 text-center">ID</th>
                <th class="p-4 w-32">Hình ảnh</th>
                <th class="p-4">Tiêu đề bài viết</th>
                <th class="p-4 w-40">Ngày đăng</th>
                <th class="p-4 w-32 text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-sm">
            @foreach (var item in Model)
            {
                <tr class="hover:bg-gray-50 transition">
                    <td class="p-4 text-center font-semibold text-gray-500">#@item.MaTin</td>
                    <td class="p-4">
                        <img src="@Url.Content("~/Images/News/" + item.AnhTin)" class="w-20 h-12 object-cover rounded-lg border border-gray-100" />
                    </td>
                    <td class="p-4 font-bold text-gray-800">@item.TieuDe</td>
                    <td class="p-4 text-gray-500">@(item.NgayDang?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</td>

                    <td class="p-4">
                        <div class="flex justify-center gap-2">
                            <a href="@Url.Action("SuaTinTuc", "Admin", new { id = item.MaTin })" class="w-8 h-8 flex items-center justify-center rounded-lg bg-blue-50 text-blue-600 hover:bg-blue-600 hover:text-white transition" title="Sửa">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>
                            <a href="@Url.Action("XoaTinTuc", "Admin", new { id = item.MaTin })" class="w-8 h-8 flex items-center justify-center rounded-lg bg-red-50 text-red-600 hover:bg-red-600 hover:text-white transition" onclick="return confirm('Xóa bài này là mất luôn đó Sếp?')" title="Xóa">
                                <i class="fa-solid fa-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>