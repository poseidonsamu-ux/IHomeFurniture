@model IHomeFurniture.Models.KHACHHANG
@{
    ViewBag.Title = "Thêm Khách Hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="max-w-4xl mx-auto bg-white border border-gray-100 rounded-3xl p-8 md:p-10 shadow-sm mt-8">

    <div class="flex items-center justify-between mb-8 pb-6 border-b border-gray-100">
        <div>
            <h2 class="text-2xl font-black uppercase text-gray-800 tracking-tight">Thêm Khách Hàng Mới</h2>
            <p class="text-sm text-gray-500 mt-1">Khách hàng được thêm tại đây sẽ tự động được kích hoạt và xác thực Email.</p>
        </div>
        <a href="/Admin/QuanLyKhachHang" class="text-gray-500 hover:text-blue-600 transition font-bold text-sm flex items-center gap-2 bg-gray-50 px-4 py-2 rounded-lg">
            <i class="fa-solid fa-arrow-left"></i> Trở về danh sách
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="bg-red-50 text-red-600 p-4 rounded-xl mb-8 border border-red-100 font-semibold flex items-center">
            <i class="fa-solid fa-triangle-exclamation mr-3 text-xl"></i> @ViewBag.Error
        </div>
    }

    @using (Html.BeginForm("ThemKhachHang", "Admin", FormMethod.Post, new { @class = "space-y-6" }))
    {
        @Html.AntiForgeryToken()

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

            <div>
                <label class="block text-xs font-black uppercase tracking-wider text-gray-500 mb-2">Họ và Tên <span class="text-red-500">*</span></label>
                <input type="text" name="HoTen" required placeholder="Nhập họ tên đầy đủ..."
                       class="w-full p-4 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition font-medium text-gray-800" />
            </div>

            <div>
                <label class="block text-xs font-black uppercase tracking-wider text-gray-500 mb-2">Giới tính <span class="text-red-500">*</span></label>
                <select name="GioiTinh" class="w-full p-4 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition font-medium text-gray-800 appearance-none">
                    <option value="true">Nam</option>
                    <option value="false">Nữ</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-black uppercase tracking-wider text-gray-500 mb-2">Tài khoản đăng nhập <span class="text-red-500">*</span></label>
                <input type="text" name="TaiKhoan" required placeholder="Viết liền, không dấu..."
                       class="w-full p-4 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition font-medium text-gray-800" />
                <p class="text-[11px] text-gray-400 mt-2 font-medium"><i class="fa-solid fa-circle-info mr-1"></i> Chỉ chứa chữ và số, bắt buộc có chữ cái.</p>
            </div>

            <div>
                <label class="block text-xs font-black uppercase tracking-wider text-gray-500 mb-2">Mật khẩu <span class="text-red-500">*</span></label>
                <input type="password" name="MatKhau" required placeholder="Mật khẩu bảo mật cao..."
                       class="w-full p-4 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition font-medium text-gray-800" />
                <p class="text-[11px] text-orange-500 mt-2 font-medium"><i class="fa-solid fa-shield-halved mr-1"></i> Bắt buộc: ≥ 8 ký tự, có Hoa, Thường, Số và <b>Ký tự đặc biệt</b>.</p>
            </div>

            <div>
                <label class="block text-xs font-black uppercase tracking-wider text-gray-500 mb-2">Địa chỉ Email <span class="text-red-500">*</span></label>
                <input type="email" name="Email" required placeholder="example@gmail.com"
                       class="w-full p-4 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition font-medium text-gray-800" />
            </div>

            <div>
                <label class="block text-xs font-black uppercase tracking-wider text-gray-500 mb-2">Số điện thoại</label>
                <input type="text" name="DienThoai" placeholder="09xx xxx xxx"
                       class="w-full p-4 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition font-medium text-gray-800" />
            </div>

            <div class="md:col-span-2">
                <label class="block text-xs font-black uppercase tracking-wider text-gray-500 mb-2">Địa chỉ liên hệ</label>
                <input type="text" name="DiaChi" placeholder="Nhập địa chỉ chi tiết (Số nhà, đường, quận/huyện...)"
                       class="w-full p-4 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition font-medium text-gray-800" />
            </div>
        </div>

        <div class="flex gap-4 pt-8 mt-4 border-t border-gray-100">
            <a href="/Admin/QuanLyKhachHang" class="w-1/3 bg-white border-2 border-gray-200 hover:bg-gray-50 text-gray-700 text-center py-4 rounded-xl font-bold transition">Hủy bỏ</a>
            <button type="submit" class="w-2/3 bg-blue-600 hover:bg-blue-700 text-white py-4 rounded-xl font-black uppercase tracking-widest shadow-lg shadow-blue-200 transition active:scale-95">
                <i class="fa-solid fa-floppy-disk mr-2"></i> Lưu Khách Hàng
            </button>
        </div>
    }
</div>