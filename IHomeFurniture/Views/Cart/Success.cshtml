@{
    ViewBag.Title = "Đặt hàng thành công | iHOME";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-[75vh] flex items-center justify-center bg-zinc-50/50 py-20 px-6">
    <div class="max-w-xl w-full bg-white p-12 rounded-[3rem] shadow-2xl border border-zinc-100 text-center relative overflow-hidden">

        <div class="absolute top-0 left-0 w-full h-2 bg-orange-500"></div>
        <div class="absolute -top-24 -right-24 w-64 h-64 bg-orange-50 rounded-full opacity-50 blur-3xl"></div>

        <div class="w-24 h-24 bg-orange-50 text-orange-500 rounded-full flex items-center justify-center mx-auto mb-8 text-5xl shadow-inner relative z-10 animate-bounce">
            <i class="fa-solid fa-check"></i>
        </div>

        <h1 class="text-3xl md:text-4xl font-light text-black mb-4 relative z-10">Đặt hàng <span class="font-bold">Thành công!</span></h1>

        <p class="text-zinc-500 leading-relaxed mb-10 relative z-10 text-sm md:text-base">
            Cảm ơn sếp đã tin tưởng chọn <strong class="text-black">iHOME</strong>.<br />
            Đơn hàng của sếp đã được hệ thống ghi nhận. Nhân viên tư vấn sẽ liên hệ với sếp trong vòng 15 phút để xác nhận lại thông tin.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center relative z-10">
            <a href="/Product" class="px-10 py-4 rounded-full bg-black text-white font-black text-[11px] uppercase tracking-[0.2em] hover:bg-orange-600 transition-all shadow-lg active:scale-95">
                Tiếp tục mua sắm
            </a>
            <a href="/" class="px-10 py-4 rounded-full bg-white text-zinc-400 font-bold text-[11px] uppercase tracking-[0.2em] border border-zinc-200 hover:bg-zinc-50 transition-all">
                Về trang chủ
            </a>
        </div>

        <p class="mt-12 text-zinc-300 text-[10px] uppercase tracking-[0.2em] font-medium">iHOME Interior Design & Furniture</p>
    </div>
</div>
