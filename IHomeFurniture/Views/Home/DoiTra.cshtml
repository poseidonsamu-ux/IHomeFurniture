                    </div>
                </div>
            </div>

            <div class="bg-white p-10 rounded-[3rem] shadow-sm hover:shadow-xl transition-all duration-500 border border-zinc-100 text-center">
                <p class="text-[11px] font-bold text-zinc-300 uppercase tracking-widest mb-6">Mọi thắc mắc sếp vui lòng liên hệ</p>
                <a href="tel:1900123456" class="text-3xl font-black text-black hover:text-orange-500 transition-colors">1900 123 456</a>
            </div>
