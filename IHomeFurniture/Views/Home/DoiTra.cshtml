@{ ViewBag.Title = "Đổi trả | iHOME"; Layout = "~/Views/Shared/_Layout.cshtml"; }

<div class="bg-zinc-50 py-24 px-6 min-h-screen">
    <div class="max-w-4xl mx-auto">
        <div class="text-center mb-20">
            <h1 class="text-4xl font-light uppercase tracking-[0.3em] text-black">Quyền lợi <span class="font-bold">Khách hàng</span></h1>
            <div class="w-12 h-1 bg-orange-500 mx-auto mt-6"></div>
        </div>

        <div class="space-y-6">
