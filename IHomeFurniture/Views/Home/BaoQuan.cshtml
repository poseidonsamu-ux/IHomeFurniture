@{ ViewBag.Title = "Bảo quản | iHOME"; Layout = "~/Views/Shared/_Layout.cshtml"; }

<div class="bg-black text-white py-24 px-6 overflow-hidden">
    <div class="max-w-6xl mx-auto relative">
        <div class="absolute top-0 right-0 w-64 h-64 bg-orange-500 blur-[150px] opacity-20"></div>

        <div class="flex flex-col md:flex-row gap-16 items-center">
            <div class="md:w-1/2">
                <h1 class="text-5xl md:text-7xl font-light leading-none mb-8">Nâng niu <br><span class="font-black italic text-orange-500">Nội thất</span></h1>
                <p class="text-zinc-400 text-sm max-w-sm leading-relaxed mb-10">Một chút quan tâm mỗi ngày sẽ giúp món đồ của sếp luôn bền đẹp như ngày đầu tiên.</p>
                <div class="flex gap-4">
                    <div class="w-24 h-[1px] bg-white mt-3"></div>
                    <span class="text-[10px] font-black uppercase tracking-widest">Hướng dẫn từ iHome Expert</span>
                </div>
            </div>

            <div class="md:w-1/2 grid grid-cols-1 gap-4">
                <div class="group bg-zinc-900 p-8 rounded-3xl hover:bg-orange-500 transition-all duration-500">
                    <h4 class="font-black text-xs uppercase tracking-widest mb-4 group-hover:text-black">01. Tránh ánh nắng</h4>
                    <p class="text-zinc-500 group-hover:text-white/80 text-sm italic">Ánh nắng trực tiếp sẽ làm phai màu sơn và gây nứt nẻ gỗ. Sếp nên dùng rèm che nhé.</p>
                </div>
                <div class="group bg-zinc-900 p-8 rounded-3xl hover:bg-orange-500 transition-all duration-500">
                    <h4 class="font-black text-xs uppercase tracking-widest mb-4 group-hover:text-black">02. Độ ẩm lý tưởng</h4>
                    <p class="text-zinc-500 group-hover:text-white/80 text-sm italic">Độ ẩm 50-60% là hoàn hảo. Đừng để nội thất quá sát tường ẩm hoặc máy điều hòa thổi trực tiếp.</p>
                </div>
                <div class="group bg-zinc-900 p-8 rounded-3xl hover:bg-orange-500 transition-all duration-500">
                    <h4 class="font-black text-xs uppercase tracking-widest mb-4 group-hover:text-black">03. Vệ sinh khăn mềm</h4>
                    <p class="text-zinc-500 group-hover:text-white/80 text-sm italic">Sếp chỉ cần dùng khăn sợi vải mềm ẩm để lau. Tuyệt đối đừng dùng các chất tẩy rửa hóa học mạnh.</p>
                </div>
            </div>
        </div>
    </div>
</div>