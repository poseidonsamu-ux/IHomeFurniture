@model IEnumerable<IHomeFurniture.Models.TINTUC>
@{
    ViewBag.Title = "Journal | iHOME";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="bg-white min-h-screen text-zinc-900 pb-32 overflow-hidden">
    <header class="pt-32 pb-20 px-6 relative">
        <div class="max-w-[1440px] mx-auto flex flex-col md:flex-row items-center gap-16">
            <div class="flex-1 space-y-8">
                <div class="inline-block px-4 py-1.5 bg-zinc-100 rounded-full text-[10px] font-black uppercase tracking-[0.4em] text-zinc-400">
                    Discover iHome Stories
                </div>
                <h1 class="text-7xl md:text-9xl font-black leading-none uppercase tracking-tighter italic">
                    The <span class="text-orange-500">Blog</span> <br />
                    <span class="text-zinc-200 not-italic tracking-normal">Journal.</span>
                </h1>
            </div>
            <div class="w-full md:w-1/3">
                <p class="text-zinc-400 text-sm leading-relaxed border-l-2 border-orange-500 pl-6 uppercase font-bold tracking-widest">
                    Cập nhật xu hướng thiết kế nội thất mới nhất và những câu chuyện đằng sau mỗi không gian sống tại iHome.
                </p>
            </div>
        </div>
    </header>

    <section class="max-w-[1800px] mx-auto px-6 lg:px-20 pt-20">
        <div class="flex flex-col lg:flex-row gap-20">
            @if (Model != null && Model.Any())
            {
                var firstPost = Model.First();
                var remainingPosts = Model.Skip(1).ToList();

                <div class="lg:w-7/12 group cursor-pointer" onclick="window.location.href='/News/ChiTiet/@firstPost.MaTin'">
                    <div class="relative overflow-hidden rounded-[4rem] bg-zinc-100 aspect-[16/10] mb-10 shadow-2xl">
                        <img src="@Url.Content("~/Images/News/" + firstPost.AnhTin)"
                             class="w-full h-full object-cover transition-transform duration-[2s] group-hover:scale-105" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-16">
                            <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center text-black">
                                <i class="fa-solid fa-arrow-right -rotate-45 text-xl"></i>
                            </div>
                        </div>
                    </div>
                    <div class="space-y-6">
                        <div class="flex items-center gap-4">
                            <span class="px-4 py-1 bg-orange-500 text-white text-[10px] font-black uppercase tracking-widest rounded-full">Tiêu điểm</span>
                            <span class="text-zinc-400 text-xs font-bold uppercase tracking-widest">@firstPost.NgayDang.Value.ToString("dd . MM . yyyy")</span>
                        </div>
                        <h3 class="text-4xl md:text-6xl font-black leading-[1.1] uppercase tracking-tighter group-hover:text-orange-500 transition-colors">
                            @firstPost.TieuDe
                        </h3>
                    </div>
                </div>

                <div class="lg:w-5/12 space-y-20">
                    @foreach (var item in remainingPosts.Take(3)) 
                    {
                        <div class="flex flex-col sm:flex-row gap-8 group cursor-pointer border-b border-zinc-100 pb-12 last:border-none"
                             onclick="window.location.href='/News/ChiTiet/@item.MaTin'">
                            <div class="w-full sm:w-48 h-48 flex-shrink-0 overflow-hidden rounded-[2rem] bg-zinc-100 shadow-xl">
                                <img src="@Url.Content("~/Images/News/" + item.AnhTin)"
                                     class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                            </div>
                            <div class="flex flex-col justify-center">
                                <span class="text-[10px] font-black text-orange-500 uppercase tracking-widest mb-3">0@(remainingPosts.IndexOf(item) + 2) . Journal</span>
                                <h4 class="text-xl font-bold leading-tight group-hover:text-orange-500 transition-colors line-clamp-2 uppercase tracking-tighter">
                                    @item.TieuDe
                                </h4>
                                <p class="text-zinc-400 text-sm mt-4 line-clamp-2 leading-relaxed">
                                    @Html.Raw(System.Text.RegularExpressions.Regex.Replace(item.NoiDung, "<.*?>", string.Empty))
                                </p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mt-32 border-t border-zinc-100 pt-32">
            @if (Model != null && Model.Count() > 4)
            {
                foreach (var item in Model.Skip(4))
                {
                    <div class="group cursor-pointer" onclick="window.location.href='/News/ChiTiet/@item.MaTin'">
                        <div class="relative aspect-square overflow-hidden rounded-[2.5rem] bg-zinc-100 mb-8">
                            <img src="@Url.Content("~/Images/News/" + item.AnhTin)" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-110" />
                        </div>
                        <h5 class="text-sm font-black uppercase tracking-widest group-hover:text-orange-500 transition-colors line-clamp-2">@item.TieuDe</h5>
                    </div>
                }
            }
        </div>
    </section>
</div>

<style>

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>