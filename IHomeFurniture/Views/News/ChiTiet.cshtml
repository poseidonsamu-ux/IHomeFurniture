@model IHomeFurniture.Models.TINTUC
@{
    ViewBag.Title = Model.TieuDe;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="bg-zinc-50 py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="bg-white px-6 py-10 md:px-12 md:py-16 lg:px-20 rounded-[2rem] shadow-sm border border-zinc-200/60">

            @* Nút quay lại *@
            <a href="/" class="text-[11px] uppercase tracking-[0.2em] font-bold text-zinc-400 hover:text-orange-600 transition-colors mb-10 inline-flex items-center gap-2">
                <i class="fa-solid fa-arrow-left-long"></i> Trở về Trang chủ
            </a>

            @* Header Bài Viết *@
            <h1 class="text-3xl md:text-5xl lg:text-[54px] font-black tracking-tight text-zinc-900 mb-8 leading-[1.15]">
                @Model.TieuDe
            </h1>

            <div class="flex flex-wrap items-center gap-5 text-[11px] text-zinc-500 uppercase tracking-widest mb-10 pb-8 border-b border-zinc-100 font-medium">
                <span class="flex items-center"><i class="fa-regular fa-calendar-days mr-2 text-lg"></i> @(Model.NgayDang.HasValue ? Model.NgayDang.Value.ToString("dd/MM/yyyy") : "Đang cập nhật")</span>
                <span class="flex items-center"><i class="fa-regular fa-eye mr-2 text-lg"></i> @Model.LuotXem Lượt xem</span>
                <span class="bg-orange-100 text-orange-600 px-4 py-1.5 rounded-full font-black">TIN TỨC NỘI THẤT</span>
            </div>

            @* Đoạn tóm tắt (Sapo) *@
            @if (!string.IsNullOrEmpty(Model.TomTat))
            {
                <p class="text-xl md:text-2xl font-medium text-zinc-700 mb-12 italic border-l-4 border-orange-500 pl-6 py-2 bg-orange-50/50 rounded-r-2xl leading-relaxed">
                    @Model.TomTat
                </p>
            }

            @* Ảnh bìa bài viết *@
            @if (!string.IsNullOrEmpty(Model.AnhTin))
            {
                <div class="rounded-2xl overflow-hidden mb-14 shadow-md bg-zinc-100">
                    <img src="@Url.Content("~/Images/News/" + Model.AnhTin)"
                         onerror="this.src='https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&q=80'"
                         alt="@Model.TieuDe"
                         class="w-full aspect-video object-cover hover:scale-105 transition-transform duration-700 ease-out" />
                </div>
            }

            @* Nội dung chi tiết *@
            <div class="prose prose-zinc prose-xl md:prose-2xl max-w-none text-zinc-700 leading-relaxed
                        prose-headings:text-zinc-900 prose-headings:font-black prose-headings:tracking-tight
                        prose-img:rounded-3xl prose-img:shadow-lg prose-a:text-orange-600 prose-a:no-underline hover:prose-a:underline">
                @Html.Raw(Model.NoiDung)
            </div>

            @* Nút chia sẻ *@
            <div class="mt-16 pt-10 border-t border-zinc-100 flex flex-col sm:flex-row items-center justify-between gap-6">
                <span class="text-sm font-bold text-zinc-900 uppercase tracking-widest">Chia sẻ bài viết</span>
                <div class="flex gap-5 text-2xl text-zinc-300">
                    <a href="#" class="hover:text-blue-600 hover:-translate-y-1 transition-all"><i class="fa-brands fa-facebook"></i></a>
                    <a href="#" class="hover:text-sky-500 hover:-translate-y-1 transition-all"><i class="fa-brands fa-twitter"></i></a>
                    <a href="#" class="hover:text-red-500 hover:-translate-y-1 transition-all"><i class="fa-brands fa-pinterest"></i></a>
                </div>
            </div>

        </div>
    </div>
</div>