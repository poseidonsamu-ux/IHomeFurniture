@model IEnumerable<IHomeFurniture.Models.SANPHAM>
@{
    ViewBag.Title = "Cửa hàng Nội thất | iHOME";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPage ?? 1;
}

<div class="bg-zinc-50 py-16 md:py-24 border-b border-zinc-100 text-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-30 pointer-events-none">
        <div class="absolute top-[-50%] left-[20%] w-[50%] h-[200%] bg-orange-50 blur-[100px] rotate-45"></div>
    </div>
    <div class="relative z-10">
        <h1 class="text-4xl md:text-5xl font-light text-black mb-4">
            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
            {
                <text>Bộ sưu tập <span class="font-bold">@ViewBag.SearchTerm</span></text>
            }
            else
            {
                <text>Tất cả <span class="font-bold">Sản phẩm</span></text>
            }
        </h1>
        <p class="text-zinc-400 text-xs tracking-[0.3em] uppercase font-bold">Kiến tạo không gian sống mơ ước</p>
    </div>
</div>

<section class="py-16 max-w-[1440px] mx-auto px-6 lg:px-12 flex flex-col lg:flex-row gap-12">

    <aside class="w-full lg:w-64 flex-shrink-0 space-y-10 hidden lg:block">
       

        <div>
            <h3 class="text-xs font-black uppercase tracking-widest text-black mb-6">Danh mục</h3>
            <ul class="space-y-4 text-sm text-zinc-500 font-medium">
                <li>
                    <a href="/Product/Index?brandId=@ViewBag.BrandId&priceRange=@ViewBag.PriceRange&searchTerm=@ViewBag.SearchTerm"
                       class="hover:text-orange-500 transition-colors @(ViewBag.CategoryId == null ? "text-orange-500 font-bold" : "")">Tất cả</a>
                </li>
                @if (ViewBag.Categories != null)
                {
                    var categories = (List<IHomeFurniture.Models.DANHMUC>)ViewBag.Categories;
                    for (int i = 0; i < categories.Count; i++)
                    {
                        <li class="@(i >= 5 ? "hidden extra-dm" : "")">
                            <a href="/Product/Index?categoryId=@categories[i].MaDM&brandId=@ViewBag.BrandId&priceRange=@ViewBag.PriceRange&searchTerm=@ViewBag.SearchTerm"
                               class="hover:text-orange-500 transition-colors @(ViewBag.CategoryId == categories[i].MaDM ? "text-orange-500 font-bold" : "")">
                                @categories[i].TenDanhMuc
                            </a>
                        </li>
                    }
                    if (categories.Count > 5)
                    {
                        <li>
                            <button onclick="ToggleExtraItems('extra-dm', this)" class="text-[10px] font-black uppercase tracking-widest text-zinc-400 hover:text-orange-500 transition-colors mt-2">
                                + Xem thêm
                            </button>
                        </li>
                    }
                }
            </ul>
        </div>

        <div>
            <h3 class="text-xs font-black uppercase tracking-widest text-black mb-6">Thương hiệu</h3>
            <div class="flex flex-wrap gap-2">
                <a href="/Product/Index?categoryId=@ViewBag.CategoryId&priceRange=@ViewBag.PriceRange&searchTerm=@ViewBag.SearchTerm"
                   class="px-4 py-2 text-[10px] border rounded-md font-bold uppercase tracking-widest transition-all @(ViewBag.BrandId == null ? "bg-black text-white border-black" : "bg-white text-zinc-400 border-zinc-200 hover:border-black hover:text-black")">
                    Tất cả
                </a>
                @if (ViewBag.Brands != null)
                {
                    var brands = (List<IHomeFurniture.Models.THUONGHIEU>)ViewBag.Brands;
                    for (int i = 0; i < brands.Count; i++)
                    {
                        <a href="/Product/Index?brandId=@brands[i].MaTH&categoryId=@ViewBag.CategoryId&priceRange=@ViewBag.PriceRange&searchTerm=@ViewBag.SearchTerm"
                           class="@(i >= 5 ? "hidden extra-th" : "") px-4 py-2 text-[10px] border rounded-md font-bold uppercase tracking-widest transition-all @(ViewBag.BrandId == brands[i].MaTH ? "bg-orange-500 text-white border-orange-500 shadow-lg shadow-orange-100" : "bg-white text-zinc-400 border-zinc-200 hover:border-black hover:text-black")">
                            @brands[i].TenTH
                        </a>
                    }
                    if (brands.Count > 5)
                    {
                        <button onclick="ToggleExtraItems('extra-th', this)" class="w-full text-left text-[10px] font-black uppercase tracking-widest text-zinc-400 hover:text-orange-500 mt-4 transition-colors">
                            + Xem thêm thương hiệu
                        </button>
                    }
                }
            </div>
        </div>

        <div>
            <h3 class="text-xs font-black uppercase tracking-widest text-black mb-6">Mức giá</h3>
            <ul class="space-y-4 text-sm text-zinc-500 font-medium">
                <li>
                    <a href="/Product/Index?categoryId=@ViewBag.CategoryId&brandId=@ViewBag.BrandId&searchTerm=@ViewBag.SearchTerm"
                       class="flex items-center gap-3 cursor-pointer hover:text-black @(string.IsNullOrEmpty(ViewBag.PriceRange) ? "text-orange-500 font-bold" : "")">
                        <i class="fa-solid fa-rotate-left text-xs"></i> Tất cả mức giá
                    </a>
                </li>

                <li>
                    <a href="/Product/Index?categoryId=@ViewBag.CategoryId&brandId=@ViewBag.BrandId&priceRange=under2&searchTerm=@ViewBag.SearchTerm" class="flex items-center gap-3 cursor-pointer hover:text-black @(ViewBag.PriceRange == "under2" ? "text-orange-500 font-bold" : "")">
                        <div class="w-4 h-4 border rounded-sm flex items-center justify-center transition-colors @(ViewBag.PriceRange == "under2" ? "bg-orange-500 border-orange-500 text-white" : "border-zinc-300 text-transparent")"><i class="fa-solid fa-check text-[10px]"></i></div>
                        Dưới 2 triệu
                    </a>
                </li>
                <li>
                    <a href="/Product/Index?categoryId=@ViewBag.CategoryId&brandId=@ViewBag.BrandId&priceRange=2to5&searchTerm=@ViewBag.SearchTerm" class="flex items-center gap-3 cursor-pointer hover:text-black @(ViewBag.PriceRange == "2to5" ? "text-orange-500 font-bold" : "")">
                        <div class="w-4 h-4 border rounded-sm flex items-center justify-center transition-colors @(ViewBag.PriceRange == "2to5" ? "bg-orange-500 border-orange-500 text-white" : "border-zinc-300 text-transparent")"><i class="fa-solid fa-check text-[10px]"></i></div>
                        2 - 5 triệu
                    </a>
                </li>
                <li>
                    <a href="/Product/Index?categoryId=@ViewBag.CategoryId&brandId=@ViewBag.BrandId&priceRange=5to10&searchTerm=@ViewBag.SearchTerm" class="flex items-center gap-3 cursor-pointer hover:text-black @(ViewBag.PriceRange == "5to10" ? "text-orange-500 font-bold" : "")">
                        <div class="w-4 h-4 border rounded-sm flex items-center justify-center transition-colors @(ViewBag.PriceRange == "5to10" ? "bg-orange-500 border-orange-500 text-white" : "border-zinc-300 text-transparent")"><i class="fa-solid fa-check text-[10px]"></i></div>
                        5 - 10 triệu
                    </a>
                </li>
                <li>
                    <a href="/Product/Index?categoryId=@ViewBag.CategoryId&brandId=@ViewBag.BrandId&priceRange=over10&searchTerm=@ViewBag.SearchTerm" class="flex items-center gap-3 cursor-pointer hover:text-black @(ViewBag.PriceRange == "over10" ? "text-orange-500 font-bold" : "")">
                        <div class="w-4 h-4 border rounded-sm flex items-center justify-center transition-colors @(ViewBag.PriceRange == "over10" ? "bg-orange-500 border-orange-500 text-white" : "border-zinc-300 text-transparent")"><i class="fa-solid fa-check text-[10px]"></i></div>
                        Trên 10 triệu
                    </a>
                </li>
            </ul>
        </div>
    </aside>

    <div class="flex-1">

        @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
        {
            <div class="mb-10">
                <h2 class="text-2xl font-light text-zinc-400 uppercase tracking-[0.2em] mb-2">
                    Kết quả cho: <span class="font-black text-black italic">"@ViewBag.SearchTerm"</span>
                </h2>
                <a href="/Product/Index" class="text-[10px] font-black uppercase tracking-widest text-orange-500 hover:text-red-500 transition-colors">
                    <i class="fa-solid fa-circle-xmark mr-1"></i> Xóa tìm kiếm
                </a>
            </div>
        }

        <div class="flex flex-col sm:flex-row justify-between items-center mb-8 gap-4 pb-4 border-b border-zinc-100">
            <span class="text-[11px] font-bold text-zinc-400 uppercase tracking-widest">
                Hiển thị <span class="text-black">@ViewBag.TotalItem</span> sản phẩm (Trang @ViewBag.CurrentPage)
            </span>

            <div class="flex items-center gap-4 text-sm relative group">
                <span class="text-zinc-400 text-[11px] uppercase tracking-widest font-bold">Sắp xếp:</span>

                <div class="relative inline-block text-left min-w-[150px]">
                    <button type="button" onclick="document.getElementById('sortOptions').classList.toggle('hidden')"
                            class="flex items-center justify-between w-full bg-white border border-zinc-200 px-4 py-2 rounded-full text-[11px] font-black uppercase tracking-widest hover:border-black transition-all">
                        <span>@(ViewBag.SortName ?? "Mới nhất")</span>
                        <i class="fa-solid fa-chevron-down text-[9px] ml-2"></i>
                    </button>

                    <div id="sortOptions" class="hidden absolute right-0 mt-2 w-48 bg-white border border-zinc-100 rounded-2xl shadow-xl z-[60] overflow-hidden">
                        <div class="py-1">
                            <a href="@Url.Action("Index", "Product", new { sortOrder = "newest", categoryId = ViewBag.CategoryId, brandId = ViewBag.BrandId, priceRange = ViewBag.PriceRange, searchTerm = ViewBag.SearchTerm })"
                               class="block px-5 py-3 text-[11px] font-bold uppercase tracking-wider text-zinc-600 hover:bg-zinc-50 hover:text-orange-500 transition-colors">Mới nhất</a>

                            <a href="@Url.Action("Index", "Product", new { sortOrder = "price_asc", categoryId = ViewBag.CategoryId, brandId = ViewBag.BrandId, priceRange = ViewBag.PriceRange, searchTerm = ViewBag.SearchTerm })"
                               class="block px-5 py-3 text-[11px] font-bold uppercase tracking-wider text-zinc-600 hover:bg-zinc-50 hover:text-orange-500 transition-colors border-t border-zinc-50">Giá tăng dần</a>

                            <a href="@Url.Action("Index", "Product", new { sortOrder = "price_desc", categoryId = ViewBag.CategoryId, brandId = ViewBag.BrandId, priceRange = ViewBag.PriceRange, searchTerm = ViewBag.SearchTerm })"
                               class="block px-5 py-3 text-[11px] font-bold uppercase tracking-wider text-zinc-600 hover:bg-zinc-50 hover:text-orange-500 transition-colors border-t border-zinc-50">Giá giảm dần</a>

                            <a href="@Url.Action("Index", "Product", new { sortOrder = "best_seller", categoryId = ViewBag.CategoryId, brandId = ViewBag.BrandId, priceRange = ViewBag.PriceRange, searchTerm = ViewBag.SearchTerm })"
                               class="block px-5 py-3 text-[11px] font-bold uppercase tracking-wider text-zinc-600 hover:bg-zinc-50 hover:text-orange-500 transition-colors border-t border-zinc-50">Bán chạy</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-x-6 gap-y-12">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <div class="group">
                        <div class="relative overflow-hidden aspect-[4/5] bg-zinc-50 rounded-sm mb-4 cursor-pointer" onclick="window.location.href='/Product/Detail/@item.MaSP'">
                            <img src="@Url.Content("~/Images/" + item.AnhBia)" alt="@item.TenSP" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">

                            @if (item.GiaKhuyenMai > 0 && item.GiaKhuyenMai < item.GiaBan)
                            {
                                <div class="absolute top-4 left-4 bg-orange-500 text-white text-[10px] px-2 py-1 uppercase tracking-widest font-bold">Sale</div>
                            }
                            else
                            {
                                <div class="absolute top-4 left-4 bg-black text-white text-[10px] px-2 py-1 uppercase tracking-widest">New</div>
                            }

                            <div class="absolute inset-x-0 bottom-0 p-4 translate-y-full group-hover:translate-y-0 transition-transform duration-300 bg-gradient-to-t from-black/60 to-transparent">
                                <button type="button" onclick="openQuantityModal(event, @item.MaSP)" class="w-full bg-white text-black h-12 rounded-full text-[10px] font-black uppercase tracking-[0.1em] hover:bg-orange-500 hover:text-white transition-all shadow-lg active:scale-95 flex items-center justify-center gap-2">
                                    <i class="fa-solid fa-cart-plus"></i> Thêm vào giỏ
                                </button>
                            </div>
                        </div>

                        <div>
                            <a href="/Product/Detail/@item.MaSP" class="text-sm font-medium text-zinc-800 hover:text-orange-500 transition-colors line-clamp-1">@item.TenSP</a>
                            <div class="flex items-center gap-3 mt-1.5">
                                @if (item.GiaKhuyenMai > 0 && item.GiaKhuyenMai < item.GiaBan)
                                {
                                    <span class="text-sm font-bold text-orange-500">@String.Format("{0:N0}", item.GiaKhuyenMai)đ</span>
                                    <span class="text-[11px] text-zinc-400 line-through">@String.Format("{0:N0}", item.GiaBan)đ</span>
                                }
                                else
                                {
                                    <span class="text-sm font-bold text-black">@String.Format("{0:N0}", item.GiaBan)đ</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-span-full py-24 text-center border-2 border-dashed border-zinc-100 rounded-[3rem]">
                    <div class="w-20 h-20 bg-zinc-50 rounded-full flex items-center justify-center mx-auto mb-6 text-zinc-200 text-3xl">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>
                    <h3 class="text-lg font-bold text-black uppercase tracking-tighter">Không tìm thấy sản phẩm nào</h3>
                    <p class="text-zinc-400 text-sm mt-2">Thử tìm bằng từ khóa khác hoặc xóa bộ lọc xem sao nhé!</p>
                    <a href="/Product/Index" class="inline-block mt-8 px-8 py-3 bg-black text-white text-[10px] font-black uppercase tracking-widest rounded-full hover:bg-orange-500 transition-all shadow-lg">
                        Quay lại cửa hàng
                    </a>
                </div>
            }
        </div>

        <div class="mt-16 flex justify-center gap-2">
            @if (ViewBag.TotalPage != null && ViewBag.TotalPage > 1)
            {
                if (ViewBag.CurrentPage > 1)
                {
                    <a href="/Product/Index?page=@(ViewBag.CurrentPage - 1)&categoryId=@ViewBag.CategoryId&priceRange=@ViewBag.PriceRange&searchTerm=@ViewBag.SearchTerm" class="w-10 h-10 flex items-center justify-center bg-white border border-zinc-200 text-zinc-500 hover:border-black hover:text-black rounded-full text-sm font-medium transition-colors">
                        <i class="fa-solid fa-chevron-left text-[10px]"></i>
                    </a>
                }

                for (int i = 1; i <= ViewBag.TotalPage; i++)
                {
                    if (i == ViewBag.CurrentPage)
                    {
                        <span class="w-10 h-10 flex items-center justify-center bg-black text-white rounded-full text-sm font-bold shadow-md pointer-events-none">@i</span>
                    }
                    else
                    {
                        <a href="/Product/Index?page=@i&categoryId=@ViewBag.CategoryId&priceRange=@ViewBag.PriceRange&searchTerm=@ViewBag.SearchTerm" class="w-10 h-10 flex items-center justify-center bg-white border border-zinc-200 text-zinc-500 hover:border-black hover:text-black rounded-full text-sm font-medium transition-colors">@i</a>
                    }
                }

                if (ViewBag.CurrentPage < ViewBag.TotalPage)
                {
                    <a href="/Product/Index?page=@(ViewBag.CurrentPage + 1)&categoryId=@ViewBag.CategoryId&priceRange=@ViewBag.PriceRange&searchTerm=@ViewBag.SearchTerm" class="w-10 h-10 flex items-center justify-center bg-white border border-zinc-200 text-zinc-500 hover:border-black hover:text-black rounded-full text-sm font-medium transition-colors">
                        <i class="fa-solid fa-chevron-right text-[10px]"></i>
                    </a>
                }
            }
        </div>
    </div>
</section>

<div id="quantityModal" class="fixed inset-0 z-[100] hidden bg-black/60 backdrop-blur-sm flex items-center justify-center transition-all duration-300 opacity-0">
    <div id="quantityModalContent" class="bg-white rounded-[2rem] p-8 max-w-sm w-full mx-4 shadow-2xl transform scale-90 transition-all duration-300 relative">
        <button type="button" onclick="dongQuantityModal()" class="absolute top-4 right-4 w-8 h-8 flex items-center justify-center text-zinc-400 hover:text-black hover:bg-zinc-100 rounded-full transition-colors">
            <i class="fa-solid fa-xmark"></i>
        </button>

        <h3 class="text-xl font-bold text-center text-black mb-2">Chọn số lượng</h3>
        <p class="text-center text-zinc-500 mb-8 text-[13px]">Bạn muốn mua bao nhiêu sản phẩm?</p>

        <input type="hidden" id="modalProductId" value="" />

        <div class="flex items-center justify-center bg-zinc-50 border border-zinc-200 rounded-full w-40 mx-auto shadow-sm mb-8 p-1">
            <button type="button" onclick="updateModalQty(-1)" class="w-10 h-10 flex items-center justify-center text-zinc-500 hover:text-black transition-colors text-lg font-bold">-</button>
            <input type="number" id="modalQty" value="1" min="1" max="99" class="w-16 h-10 text-center text-lg font-black border-none outline-none bg-transparent" readonly>
            <button type="button" onclick="updateModalQty(1)" class="w-10 h-10 flex items-center justify-center text-zinc-500 hover:text-black transition-colors text-lg font-bold">+</button>
        </div>

        <button id="btnXacNhan" onclick="ThemVaoGioHangTuIndex()" class="w-full py-4 rounded-full bg-black text-white font-black text-[11px] uppercase tracking-[0.2em] hover:bg-orange-500 transition-colors text-center shadow-lg hover:shadow-orange-200">
            Xác nhận thêm
        </button>
    </div>
</div>

<div id="cartModal" class="fixed inset-0 z-[110] hidden bg-black/60 backdrop-blur-sm flex items-center justify-center transition-all duration-300 opacity-0">
    <div id="cartModalContent" class="bg-white rounded-[2rem] p-10 max-w-sm w-full mx-4 shadow-2xl transform scale-90 transition-all duration-300">
        <div class="w-20 h-20 bg-orange-50 text-orange-500 rounded-full flex items-center justify-center mx-auto mb-6 text-4xl shadow-inner">
            <i class="fa-solid fa-check"></i>
        </div>

        <h3 class="text-2xl font-light text-center text-black mb-2 tracking-tight">Thành công!</h3>
        <p class="text-center text-zinc-400 mb-10 text-[13px] font-medium uppercase tracking-wider">Đã thêm vào giỏ hàng</p>

        <div class="flex flex-col gap-3">
            <a href="/Cart/Index" class="w-full py-4 rounded-full bg-black text-white font-black text-[11px] uppercase tracking-[0.2em] hover:bg-orange-600 transition-all text-center shadow-lg shadow-zinc-200">
                Xem giỏ hàng
            </a>
            <button type="button" onclick="dongModalThanhCong()" class="w-full py-4 rounded-full bg-zinc-50 text-zinc-400 font-bold text-[11px] uppercase tracking-[0.2em] hover:bg-zinc-100 transition-all text-center">
                Tiếp tục mua sắm
            </button>
        </div>
    </div>
</div>

<script>
    //SHOW THÊM
    function ToggleExtraItems(className, btn) {
        // Lấy tất cả các phần tử có class tương ứng (extra-dm hoặc extra-th)
        const items = document.querySelectorAll('.' + className);

        // Kiểm tra xem hiện tại đang ẩn hay hiện
        const isHidden = items[0].classList.contains('hidden');

        if (isHidden) {
            // Nếu đang ẩn -> Hiện ra
            items.forEach(item => {
                item.classList.remove('hidden');
                // Thêm hiệu ứng hiện hình mượt mà nếu thích
                item.classList.add('animate-fade-in');
            });
            btn.innerText = "- Thu gọn";
        } else {
            // Nếu đang hiện -> Ẩn đi
            items.forEach(item => item.classList.add('hidden'));
            btn.innerText = "+ Xem thêm";
        }
    }

    // --- MỞ/ĐÓNG POPUP SỐ LƯỢNG ---
    function openQuantityModal(event, productId) {
        event.stopPropagation(); // Ngăn click nhầm vào link chi tiết SP
        document.getElementById('modalProductId').value = productId;
        document.getElementById('modalQty').value = 1;

        // Trả lại text nút (nếu lỡ trước đó đã bấm Đang xử lý)
        document.getElementById('btnXacNhan').innerText = "XÁC NHẬN THÊM";

        $('#quantityModal').removeClass('hidden');
        setTimeout(() => {
            $('#quantityModal').removeClass('opacity-0').addClass('opacity-100');
            $('#quantityModalContent').removeClass('scale-90').addClass('scale-100');
        }, 10);
    }

    function dongQuantityModal() {
        $('#quantityModal').removeClass('opacity-100').addClass('opacity-0');
        $('#quantityModalContent').removeClass('scale-100').addClass('scale-90');
        setTimeout(() => {
            $('#quantityModal').addClass('hidden');
        }, 300);
    }

    // --- TĂNG GIẢM SỐ LƯỢNG TRONG POPUP ---
    function updateModalQty(change) {
        const input = document.getElementById('modalQty');
        let current = parseInt(input.value);
        let newVal = current + change;
        if (newVal >= 1 && newVal <= 99) {
            input.value = newVal;
        }
    }

    // --- AJAX: GỬI LÊN MÁY CHỦ ---
    function ThemVaoGioHangTuIndex() {
        var maSanPham = $('#modalProductId').val();
        var soLuong = $('#modalQty').val();

        // Đổi trạng thái nút bấm cho ngầu
        document.getElementById('btnXacNhan').innerText = "ĐANG XỬ LÝ...";

        $.ajax({
            url: '/Cart/Add',
            type: 'POST',
            data: {
                productId: maSanPham,
                quantity: soLuong
            },
            success: function (res) {
                if (res.success) {
                    // Update số lượng trên Navbar
                    if ($('#cart-count').length > 0) {
                        $('#cart-count').text(res.cartCount);
                    }

                    dongQuantityModal(); // Tắt popup cũ

                    setTimeout(() => {
                        moModalThanhCong(); // Bật popup mới
                    }, 300); // Đợi popup kia đóng hẳn rồi mới mở cho mượt
                } else {
                    alert("Lỗi: " + res.message);
                    document.getElementById('btnXacNhan').innerText = "XÁC NHẬN THÊM";
                }
            },
            error: function () {
                alert("Máy chủ đang lười biếng. Bạn thử lại nha!");
                document.getElementById('btnXacNhan').innerText = "XÁC NHẬN THÊM";
            }
        });
    }

    // --- MỞ/ĐÓNG POPUP THÀNH CÔNG ---
    function moModalThanhCong() {
        $('#cartModal').removeClass('hidden');
        setTimeout(() => {
            $('#cartModal').removeClass('opacity-0').addClass('opacity-100');
            $('#cartModalContent').removeClass('scale-90').addClass('scale-100');
        }, 10);
    }

    function dongModalThanhCong() {
        $('#cartModal').removeClass('opacity-100').addClass('opacity-0');
        $('#cartModalContent').removeClass('scale-100').addClass('scale-90');
        setTimeout(() => {
            $('#cartModal').addClass('hidden');
        }, 300);
    }
</script>