@model IEnumerable<IHomeFurniture.Models.THUONGHIEU>

@{
    ViewBag.Title = "Quản lý Thương hiệu";
    // ĐỔI DÒNG NÀY: Từ _Layout.cshtml sang _LayoutAdmin.cshtml
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="flex justify-between items-center mb-8">
    <h2 class="text-2xl font-black uppercase tracking-tight">Thương Hiệu (Brand)</h2>
    <a href="/Brand/Create" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-xl font-bold transition flex items-center gap-2 shadow-lg shadow-blue-200">
        <i class="fa-solid fa-plus"></i> Thêm mới
    </a>
</div>

<div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm">
    <table class="w-full text-left border-collapse">
        <thead>
            <tr class="bg-gray-50 border-b border-gray-200 text-xs uppercase text-gray-500 font-bold">
                <th class="p-4 w-20 text-center">Mã</th>
                <th class="p-4">Tên Thương Hiệu</th>
                <th class="p-4 w-32 text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-sm">
            @foreach (var item in Model)
            {
                <tr class="hover:bg-gray-50 transition">
                    <td class="p-4 text-center font-semibold text-gray-500">#@item.MaTH</td>
                    <td class="p-4 font-bold text-gray-800">@item.TenTH</td>
                    <td class="p-4 text-center">
                        <a href="/Brand/Delete/@item.MaTH" class="text-red-500 hover:text-red-700 font-bold text-sm bg-red-50 px-3 py-1.5 rounded-md transition-colors" onclick="return confirm('Xóa brand này luôn hả Sếp?');">
                            Xóa
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>