@model IEnumerable<IHomeFurniture.Models.THUONGHIEU>
@{
    ViewBag.Title = "Thương Hiệu | iHOME";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="bg-white min-h-screen pb-32">
    <header class="pt-32 pb-20 px-6 text-center">
        <h1 class="text-5xl md:text-7xl font-black uppercase tracking-tighter italic">
            Our <span class="text-orange-500">Brands</span>
        </h1>
        <p class="text-zinc-500 mt-6 max-w-2xl mx-auto text-sm">Các đối tác nội thất hàng đầu đồng hành cùng iHome.</p>
    </header>

    <section class="max-w-7xl mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-10">
        @foreach (var item in Model)
        {
            <a href="@Url.Action("ChiTiet", "Brand", new { id = item.MaTH })" class="group block bg-zinc-50 rounded-[2rem] p-10 text-center hover:shadow-xl transition-all">
                <h3 class="font-black text-xl text-zinc-800 uppercase group-hover:text-orange-500 transition-colors">@item.TenTH</h3>
                <span class="text-[10px] text-zinc-400 uppercase tracking-widest mt-2 block">@item.DiaChi</span>
            </a>
        }
    </section>
</div>