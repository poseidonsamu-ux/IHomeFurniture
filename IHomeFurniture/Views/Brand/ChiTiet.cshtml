@model IHomeFurniture.Models.THUONGHIEU
@using IHomeFurniture.Models
@{
    ViewBag.Title = Model.TenTH + " | iHOME";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sanPhams = ViewBag.ListSanPham as List<SANPHAM>;
}

<div class="bg-white min-h-screen pb-32">
    <header class="pt-32 pb-16 px-6 bg-zinc-50 border-b border-zinc-100 mb-16 text-center">
        <h1 class="text-6xl font-black uppercase tracking-tighter text-zinc-900">@Model.TenTH</h1>
        <p class="text-zinc-500 mt-4 uppercase tracking-[0.3em] text-xs">@Model.DiaChi - @Model.DienThoai</p>
    </header>

    <section class="max-w-7xl mx-auto px-6">
        <h2 class="text-2xl font-black uppercase tracking-widest border-l-4 border-orange-500 pl-4 mb-10">Sản phẩm tiêu biểu</h2>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-10">
            @if (sanPhams != null && sanPhams.Any())
            {
                foreach (var sp in sanPhams)
                {
                    <a href="/Product/ChiTiet/@sp.MaSP" class="group block">
                        <div class="aspect-square bg-zinc-100 rounded-3xl overflow-hidden mb-4">
                            <img src="@Url.Content("~/Images/" + sp.AnhBia)" class="w-full h-full object-cover group-hover:scale-110 transition duration-500" />
                        </div>
                        <h3 class="font-bold text-sm uppercase group-hover:text-orange-500 transition-colors">@sp.TenSP</h3>
                        <p class="font-black text-zinc-900">@string.Format("{0:N0}đ", sp.GiaBan)</p>
                    </a>
                }
            }
            else
            {
                <p class="col-span-full text-zinc-400 italic">Thương hiệu này hiện chưa có sản phẩm nào.</p>
            }
        </div>
    </section>
</div>