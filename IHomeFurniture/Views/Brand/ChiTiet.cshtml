@model IHomeFurniture.Models.THUONGHIEU
@using IHomeFurniture.Models
@{
    ViewBag.Title = Model.TenTH + " | iHOME";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Lấy danh sách sản phẩm từ ViewBag
    var sanPhams = ViewBag.ListSanPham as List<SANPHAM>;
}

<div class="bg-white min-h-screen pb-32">
    <!-- Brand Info Header -->
    <header class="pt-32 pb-16 px-6 bg-zinc-50 mb-16 border-b border-zinc-100">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center gap-10">

            <!-- Logo Hãng -->
            <div class="w-40 h-40 bg-white rounded-full shadow-xl flex items-center justify-center p-6 shrink-0 border border-zinc-100">
                @if (!string.IsNullOrEmpty(Model.Logo))
                {
                    <img src="@Url.Content("~/Images/Brands/" + Model.Logo)" alt="@Model.TenTH" class="w-full h-full object-contain" />
                }
                else
                {
                    <i class="fa-solid fa-gem text-5xl text-zinc-200"></i>
                }
            </div>

            <!-- Thông tin Hãng -->
            <div class="text-center md:text-left">
                <div class="inline-block px-3 py-1 bg-zinc-200 rounded-sm text-[9px] font-black uppercase tracking-[0.3em] text-zinc-500 mb-4">
                    Brand Profile
                </div>
                <h1 class="text-4xl md:text-6xl font-black uppercase tracking-tighter text-zinc-900 mb-6">
                    @Model.TenTH
                </h1>

                <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start text-sm text-zinc-500 font-medium">
                    @if (!string.IsNullOrEmpty(Model.DiaChi))
                    {
                        <span class="flex items-center justify-center gap-2 bg-white px-4 py-2 rounded-full shadow-sm border border-zinc-100">
                            <i class="fa-solid fa-location-dot text-orange-500"></i> @Model.DiaChi
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(Model.DienThoai))
                    {
                        <span class="flex items-center justify-center gap-2 bg-white px-4 py-2 rounded-full shadow-sm border border-zinc-100">
                            <i class="fa-solid fa-phone text-orange-500"></i> @Model.DienThoai
                        </span>
                    }
                </div>
            </div>

        </div>
    </header>

    <!-- Product Grid -->
    <section class="max-w-7xl mx-auto px-6">
        <div class="flex items-center justify-between mb-10">
            <h2 class="text-2xl font-black uppercase tracking-widest border-l-4 border-orange-500 pl-4 text-zinc-800">
                Sản phẩm từ @Model.TenTH
            </h2>
            <span class="text-xs font-bold text-zinc-400 uppercase tracking-widest bg-zinc-50 px-4 py-2 rounded-full">
                @(sanPhams?.Count ?? 0) Items
            </span>
        </div>

        @if (sanPhams != null && sanPhams.Any())
        {
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-12">
                @foreach (var sp in sanPhams)
                {
                    <a href="/Product/ChiTiet/@sp.MaSP" class="group block">
                        <!-- Ảnh sản phẩm -->
                        <div class="aspect-square bg-zinc-100 rounded-3xl overflow-hidden mb-4 relative">
                            <img src="@Url.Content("~/Images/" + sp.AnhBia)" alt="@sp.TenSP" class="w-full h-full object-cover group-hover:scale-110 transition duration-700" />

                            @if (sp.GiaKhuyenMai > 0)
                            {
                                <div class="absolute top-4 left-4 bg-red-500 text-white text-[10px] font-black px-3 py-1 rounded-full uppercase tracking-wider">
                                    Sale
                                </div>
                            }
                        </div>

                        <!-- Thông tin sản phẩm -->
                        <div class="space-y-2">
                            <h3 class="font-bold text-zinc-800 line-clamp-2 group-hover:text-orange-500 transition-colors uppercase tracking-tight text-sm">
                                @sp.TenSP
                            </h3>
                            <div class="flex items-center gap-3">
                                @if (sp.GiaKhuyenMai > 0 && sp.GiaKhuyenMai < sp.GiaBan)
                                {
                                    <span class="font-black text-orange-500">@string.Format("{0:N0}đ", sp.GiaKhuyenMai)</span>
                                    <span class="text-xs text-zinc-400 line-through">@string.Format("{0:N0}đ", sp.GiaBan)</span>
                                }
                                else
                                {
                                    <span class="font-black text-zinc-900">@string.Format("{0:N0}đ", sp.GiaBan)</span>
                                }
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <!-- Báo lỗi nếu hãng chưa có sản phẩm -->
            <div class="text-center py-32 bg-zinc-50 rounded-[3rem] border border-zinc-100">
                <i class="fa-solid fa-box-open text-5xl text-zinc-300 mb-6 block"></i>
                <p class="text-zinc-500 font-medium">Thương hiệu này hiện chưa có sản phẩm nào được mở bán.</p>
                <a href="/Product/Index" class="inline-block mt-6 text-sm font-bold text-orange-500 hover:text-black uppercase tracking-widest transition-colors">
                    Khám phá thương hiệu khác <i class="fa-solid fa-arrow-right ml-2"></i>
                </a>
            </div>
        }
    </section>
</div>