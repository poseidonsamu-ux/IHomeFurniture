<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - I-HOME Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="bg-gray-100 flex h-screen overflow-hidden">

    @{
        string currentUrl = Request.RawUrl != null ? Request.RawUrl.ToLower() : "";
    }

    <aside class="w-64 bg-gray-900 text-white flex flex-col">
        <div class="h-16 flex items-center justify-center border-b border-gray-800">
            <h1 class="text-2xl font-bold tracking-widest text-white flex items-center gap-2">
                iHOME<span class="text-blue-500">.</span>
                <span class="text-[10px] bg-blue-600 text-white px-2 py-0.5 rounded uppercase tracking-wider font-semibold">Admin</span>
            </h1>
        </div>

        <nav class="flex-1 overflow-y-auto py-4">
            <ul class="space-y-1">
                <li>
                    <a href="/Admin/Index" class="flex items-center px-6 py-3 transition @(currentUrl == "/admin" || currentUrl == "/admin/index" ? "text-blue-400 bg-gray-800 border-l-4 border-blue-500" : "text-gray-300 hover:text-white hover:bg-gray-800 border-l-4 border-transparent")">
                        <i class="fa-solid fa-chart-pie w-6"></i> <span class="ml-2">Tổng quan</span>
                    </a>
                </li>
                <li>
                    <a href="/Admin/QuanLyKhachHang" class="flex items-center px-6 py-3 transition @(currentUrl.Contains("khachhang") ? "text-blue-400 bg-gray-800 border-l-4 border-blue-500" : "text-gray-300 hover:text-white hover:bg-gray-800 border-l-4 border-transparent")">
                        <i class="fa-solid fa-users w-6"></i> <span class="ml-2">Khách hàng</span>
                    </a>
                </li>
                <li>
                    <a href="/Admin/QuanLySanPham" class="flex items-center px-6 py-3 transition @(currentUrl.Contains("sanpham") ? "text-blue-400 bg-gray-800 border-l-4 border-blue-500" : "text-gray-300 hover:text-white hover:bg-gray-800 border-l-4 border-transparent")">
                        <i class="fa-solid fa-couch w-6"></i> <span class="ml-2">Sản phẩm</span>
                    </a>
                </li>
                <li>
                    <a href="/Admin/QuanLyDonHang" class="flex items-center px-6 py-3 transition @(currentUrl.Contains("donhang") ? "text-blue-400 bg-gray-800 border-l-4 border-blue-500" : "text-gray-300 hover:text-white hover:bg-gray-800 border-l-4 border-transparent")">
                        <i class="fa-solid fa-file-invoice-dollar w-6"></i> <span class="ml-2">Đơn hàng</span>
                    </a>
                </li>
                <li>
                    <a href="/Admin/QuanLyTinTuc" class="flex items-center px-6 py-3 transition @(currentUrl.Contains("tintuc") ? "text-blue-400 bg-gray-800 border-l-4 border-blue-500" : "text-gray-300 hover:text-white hover:bg-gray-800 border-l-4 border-transparent")">
                        <i class="fa-solid fa-newspaper w-6"></i> <span class="ml-2">Tin tức</span>
                    </a>
                </li>
                <li>
                    <a href="/Admin/QuanLyThuongHieu" class="flex items-center px-6 py-3 transition @(currentUrl.Contains("brand") ? "text-blue-400 bg-gray-800 border-l-4 border-blue-500" : "text-gray-300 hover:text-white hover:bg-gray-800 border-l-4 border-transparent")">
                        <i class="fa-solid fa-tags w-6"></i> <span class="ml-2">Thương hiệu</span>
                    </a>
                </li>
            </ul>
        </nav>

        <div class="p-4 border-t border-gray-800">
            <div class="flex items-center space-x-3 mb-4">
                <div class="w-8 h-8 rounded-full bg-blue-500 flex items-center justify-center text-sm font-bold">
                    AD
                </div>
                <div class="text-sm">
                    <p class="font-bold">@Session["Admin_Name"]</p>
                    <p class="text-xs text-gray-400">Quản trị viên</p>
                </div>
            </div>
            <a href="/Admin/Logout" class="block w-full text-center text-sm bg-red-600 hover:bg-red-700 py-2 rounded transition font-medium">Đăng xuất</a>
        </div>
    </aside>

    <main class="flex-1 flex flex-col h-screen overflow-y-auto">
        <header class="h-16 bg-white shadow-sm flex items-center justify-between px-8 z-10">
            <h2 class="text-xl font-bold text-gray-800">@ViewBag.Title</h2>
            <div><span class="text-sm text-gray-500 font-medium bg-gray-100 px-3 py-1.5 rounded-lg">Hôm nay: @DateTime.Now.ToString("dd/MM/yyyy")</span></div>
        </header>

        <div class="p-8">
            @RenderBody()
        </div>
    </main>

</body>
</html>