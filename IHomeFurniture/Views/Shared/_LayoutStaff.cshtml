<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - IHome Staff</title>
    <!-- Bootstrap 5 & FontAwesome -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        body {
            background-color: #f4f6f9;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        .sidebar {
            min-height: 100vh;
            background-color: #242e42;
            color: #cbd5e1;
        }

            .sidebar .nav-link {
                color: #94a3b8;
                border-radius: 8px;
                margin: 4px 12px;
                padding: 11px 16px;
                font-weight: 500;
                text-decoration: none;
                display: block;
            }

                .sidebar .nav-link:hover, .sidebar .nav-link.active {
                    background-color: #334155;
                    color: #fff;
                }

                .sidebar .nav-link i {
                    width: 22px;
                }

        .card-stat {
            border: none;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-3 col-lg-2 d-md-block sidebar collapse px-0">
                <div class="p-3 text-center border-bottom border-secondary">
                    <h5 class="fw-bold mb-0 text-white"><i class="fa-solid fa-couch text-warning me-2"></i>IHome Staff</h5>
                    <small class="text-secondary">Bộ phận Tác nghiệp</small>
                </div>
                <div class="py-3">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Staff")">
                                <i class="fa-solid fa-gauge-high"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("QuanLyDonHang", "Staff")">
                                <i class="fa-solid fa-box-open"></i> Quản lý đơn hàng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("QuanLyKhachHang", "Staff")">
                                <i class="fa-solid fa-users"></i> Quản lý khách hàng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("TheoDoiSanPham", "Staff")">
                                <i class="fa-solid fa-warehouse"></i> Theo dõi sản phẩm
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("TuVanKhachHang", "Staff")">
                                <i class="fa-solid fa-headset"></i> Tư vấn khách hàng
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main Content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>