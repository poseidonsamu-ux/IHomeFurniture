@{
    string action = Convert.ToString(
        ViewContext.RouteData.Values["action"]
    ).ToLower();

    string staffName = Convert.ToString(Session["IHomeStaffName"]);

    if (string.IsNullOrWhiteSpace(staffName))
    {
        staffName = "Nhân viên IHOME";
    }

    string active = "bg-gray-800 text-blue-400 border-blue-500";
    string normal = "text-gray-300 hover:text-white hover:bg-gray-800 border-transparent";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title - I-HOME Staff</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
          rel="stylesheet" />

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .staff-scroll::-webkit-scrollbar {
            width: 5px;
        }

        .staff-scroll::-webkit-scrollbar-thumb {
            background: #4b5563;
            border-radius: 10px;
        }

        .staff-card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 16px;
            box-shadow: 0 1px 3px rgba(0,0,0,.035);
        }

        .staff-input {
            border: 1px solid #d1d5db;
            border-radius: 10px;
            padding: 10px 14px;
            outline: none;
            background: white;
            max-width: 100%;
        }

            .staff-input:focus {
                border-color: #3b82f6;
                box-shadow: 0 0 0 3px rgba(59,130,246,.1);
            }

        .staff-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border-radius: 10px;
            background: #2563eb;
            color: white;
            padding: 10px 16px;
            font-size: 14px;
            font-weight: 600;
            transition: .2s;
        }

            .staff-button:hover {
                background: #1d4ed8;
            }

        .staff-table {
            width: 100%;
            border-collapse: collapse;
        }

            .staff-table thead {
                background: #f9fafb;
                color: #6b7280;
                font-size: 12px;
                text-transform: uppercase;
                letter-spacing: .04em;
            }

            .staff-table th {
                text-align: left;
                padding: 15px 18px;
                font-weight: 600;
                white-space: nowrap;
            }

            .staff-table td {
                padding: 15px 18px;
                border-top: 1px solid #f3f4f6;
                font-size: 14px;
            }

            .staff-table tbody tr:hover {
                background: #f9fafb;
            }

        .staff-badge {
            display: inline-block;
            padding: 5px 10px;
            font-size: 12px;
            font-weight: 600;
            border-radius: 999px;
        }

        .staff-badge-1 {
            background: #fef3c7;
            color: #92400e;
        }

        .staff-badge-2 {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .staff-badge-3 {
            background: #e0e7ff;
            color: #4338ca;
        }

        .staff-badge-4 {
            background: #dcfce7;
            color: #166534;
        }

        .staff-badge-5 {
            background: #fee2e2;
            color: #991b1b;
        }

        .staff-badge-6 {
            background: #f3e8ff;
            color: #6b21a8;
        }
    </style>
</head>

<body class="bg-gray-100 h-screen overflow-hidden">

    <div id="staffOverlay"
         class="fixed inset-0 bg-black/50 z-30 hidden lg:hidden"
         onclick="toggleStaffMenu()">
    </div>

    <aside id="staffSidebar"
           class="fixed inset-y-0 left-0 z-40 w-64
                  bg-gray-900 text-white flex flex-col
                  transform -translate-x-full
                  lg:translate-x-0 transition-transform duration-200">

        <div class="h-16 flex items-center justify-center border-b border-gray-800">
            <a href="@Url.Action("Index", "Staff")"
               class="text-2xl font-bold tracking-widest text-white flex items-center gap-2">

                iHOME<span class="text-blue-500">.</span>

                <span class="text-[10px] bg-blue-600 text-white px-2 py-0.5 rounded uppercase tracking-wider font-semibold">
                    Staff
                </span>
            </a>
        </div>

        <div class="px-6 pt-6 pb-2 text-[11px] font-bold text-gray-500 uppercase tracking-wider">
            Quản lý cửa hàng
        </div>

        <nav class="flex-1 overflow-y-auto staff-scroll py-2">

            <ul class="space-y-1">

                <li>
                    <a href="@Url.Action("Index", "Staff")"
                       class="flex items-center px-6 py-3 transition border-l-4 @(action == "index" ? active : normal)">
                        <i class="fa-solid fa-chart-pie w-6"></i>
                        <span class="ml-2">Tổng quan</span>
                    </a>
                </li>

                <li>
                    <a href="@Url.Action("QuanLyDonHang", "Staff")"
                       class="flex items-center px-6 py-3 transition border-l-4 @(action == "quanlydonhang" || action == "chitietdonhang" ? active : normal)">
                        <i class="fa-solid fa-file-invoice-dollar w-6"></i>
                        <span class="ml-2">Quản lý đơn hàng</span>
                    </a>
                </li>

                <li>
                    <a href="@Url.Action("TheoDoiSanPham", "Staff")"
                       class="flex items-center px-6 py-3 transition border-l-4 @(action == "theodoisanpham" ? active : normal)">
                        <i class="fa-solid fa-couch w-6"></i>
                        <span class="ml-2">Theo dõi sản phẩm</span>
                    </a>
                </li>

                <li>
                    <a href="@Url.Action("QuanLyKhachHang", "Staff")"
                       class="flex items-center px-6 py-3 transition border-l-4 @(action == "quanlykhachhang" ? active : normal)">
                        <i class="fa-solid fa-users w-6"></i>
                        <span class="ml-2">Quản lý khách hàng</span>
                    </a>
                </li>

                <li>
                    <a href="@Url.Action("TuVanKhachHang", "Staff")"
                       class="flex items-center px-6 py-3 transition border-l-4 @(action == "tuvankhachhang" ? active : normal)">
                        <i class="fa-solid fa-headset w-6"></i>
                        <span class="ml-2">Tư vấn khách hàng</span>
                    </a>
                </li>

            </ul>
        </nav>

        <div class="p-4 border-t border-gray-800">

            <div class="flex items-center gap-3 mb-4">

                <div class="w-9 h-9 rounded-full bg-blue-500 flex items-center justify-center text-sm font-bold shrink-0">
                    NV
                </div>

                <div class="text-sm min-w-0">
                    <p class="font-bold truncate">@staffName</p>
                    <p class="text-xs text-gray-400">Nhân viên</p>
                </div>

            </div>

            @using (Html.BeginForm(
                "DangXuat",
                "Staff",
                FormMethod.Post
            ))
            {
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="block w-full text-center text-sm bg-red-600 hover:bg-red-700 py-2 rounded transition font-medium">
                    <i class="fa-solid fa-right-from-bracket mr-2"></i>
                    Đăng xuất
                </button>
            }

        </div>

    </aside>

    <main class="lg:ml-64 h-screen flex flex-col">

        <header class="h-16 bg-white shadow-sm flex items-center justify-between px-4 lg:px-8 z-10 shrink-0">

            <div class="flex items-center gap-4">

                <button type="button"
                        onclick="toggleStaffMenu()"
                        class="lg:hidden text-gray-700 text-xl">
                    <i class="fa-solid fa-bars"></i>
                </button>

                <h2 class="text-lg lg:text-xl font-bold text-gray-800">
                    @ViewBag.Title
                </h2>

            </div>

            <div class="hidden sm:flex items-center gap-3">

                <span class="text-xs bg-green-50 text-green-700 px-3 py-1.5 rounded-lg font-semibold">
                    <i class="fa-solid fa-circle text-[7px] mr-1"></i>
                    Staff Online
                </span>

                <span class="text-sm text-gray-500 font-medium bg-gray-100 px-3 py-1.5 rounded-lg">
                    Hôm nay: @DateTime.Now.ToString("dd/MM/yyyy")
                </span>

            </div>

        </header>

        <div class="flex-1 overflow-y-auto p-4 lg:p-8">

            @if (TempData["Success"] != null)
            {
                <div class="mb-5 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl text-sm">
                    <i class="fa-solid fa-circle-check mr-2"></i>
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="mb-5 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl text-sm">
                    <i class="fa-solid fa-triangle-exclamation mr-2"></i>
                    @TempData["Error"]
                </div>
            }

            @RenderBody()

            <footer class="mt-10 pb-4 text-center text-xs text-gray-400">
                © @DateTime.Now.Year I-HOME Furniture · Staff Management
            </footer>

        </div>

    </main>

    <script>
        function toggleStaffMenu() {
            document.getElementById("staffSidebar")
                .classList.toggle("-translate-x-full");

            document.getElementById("staffOverlay")
                .classList.toggle("hidden");
        }
    </script>

    @RenderSection("scripts", required: false)

</body>
</html>